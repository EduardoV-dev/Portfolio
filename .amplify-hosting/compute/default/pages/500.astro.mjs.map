---
export const prerender = true;

import Layout from "@/layouts/layout/index.astro";
import { APP_ROUTES } from "@/constants/routes";
---

<Layout
    title="500 – System Fault | Eduardo Varela"
    description="Something went wrong while loading this page. Return home or try again shortly."
    robots="noindex,follow"
>
    <section class="fault" aria-label="Server error">
        <div class="fault__bg" aria-hidden="true">
            <div class="fault__mesh"></div>
            <div class="fault__scan"></div>
            <div class="fault__noise"></div>
            <span class="fault__code">500</span>
            <span class="fault__pulse fault__pulse--1"></span>
            <span class="fault__pulse fault__pulse--2"></span>
        </div>

        <div class="fault__inner">
            <p class="fault__badge">SYSTEM FAULT</p>

            <h1 class="fault__heading">
                Compute node returned an <span class="fault__accent">internal error.</span>
            </h1>

            <p class="fault__body">
                Request reached server, but response pipeline failed before render completed. This
                is temporary and already being investigated.
            </p>

            <div class="fault__actions">
                <a href={APP_ROUTES.HOME} class="fault__btn fault__btn--primary">
                    <span aria-hidden="true">↺</span>
                    <span>Retry Home</span>
                </a>
                <a href={APP_ROUTES.CONTACT} class="fault__btn fault__btn--secondary">
                    <span>Report Issue</span>
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </section>
</Layout>

<style>
    @import "../styles/mixins.css";

    .fault {
        position: relative;
        min-height: calc(100vh - var(--header-height, 68px));
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: clip;
        padding-block: 5rem;
    }

    .fault__bg {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .fault__mesh {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 18% 22%, rgb(255 88 96 / 20%) 0%, transparent 38%),
            radial-gradient(circle at 78% 18%, rgb(92 226 255 / 16%) 0%, transparent 35%),
            radial-gradient(circle at 50% 88%, rgb(247 180 92 / 12%) 0%, transparent 40%);
    }

    .fault__scan {
        position: absolute;
        inset: -30% 0;
        background: repeating-linear-gradient(
            180deg,
            rgb(255 255 255 / 0.03) 0,
            rgb(255 255 255 / 0.03) 1px,
            transparent 1px,
            transparent 10px
        );
        mix-blend-mode: screen;
        opacity: 0.45;
        animation: scan-drift 16s linear infinite;
    }

    .fault__noise {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgb(255 255 255 / 0.1) 0.5px, transparent 0.5px);
        background-size: 3px 3px;
        opacity: 0.08;
    }

    .fault__code {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        font-size: clamp(9rem, 34vw, 24rem);
        font-weight: 800;
        letter-spacing: -0.07em;
        line-height: 1;
        color: rgb(255 255 255 / 0.03);
        -webkit-text-stroke: 1px rgb(255 255 255 / 0.18);
        animation: glitch-shift 5.2s steps(1) infinite;
    }

    .fault__pulse {
        position: absolute;
        left: 50%;
        top: 50%;
        width: min(44vw, 440px);
        height: min(44vw, 440px);
        border-radius: 50%;
        border: 1px solid rgb(255 120 120 / 24%);
        animation: pulse 4.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    }

    .fault__pulse--2 {
        animation-delay: 2.1s;
        border-color: rgb(92 226 255 / 24%);
    }

    .fault__inner {
        position: relative;
        z-index: 1;
        max-width: 1280px;
        width: 100%;
        padding-inline: 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.35rem;
    }

    .fault__badge {
        padding: 0.42rem 0.9rem;
        border-radius: 999px;
        border: 1px solid rgb(255 120 120 / 48%);
        color: #ff7c82;
        background: linear-gradient(90deg, rgb(255 120 120 / 18%), rgb(255 120 120 / 5%));
        font-size: 0.86rem;
        font-weight: 700;
        line-height: 1;
        animation: fade-up 500ms cubic-bezier(0.22, 1, 0.36, 1) both 30ms;
    }

    .fault__badge::before {
        content: "";
        display: inline-block;
        width: 0.45rem;
        height: 0.45rem;
        margin-right: 0.55rem;
        border-radius: 50%;
        background: #ff7c82;
        box-shadow: 0 0 0 6px rgb(255 124 130 / 15%);
        vertical-align: middle;
    }

    .fault__heading {
        font-size: clamp(2rem, 8.2vw, 3.55rem);
        font-weight: 760;
        line-height: 1.05;
        letter-spacing: -0.04em;
        color: #f2f5fb;
        max-width: 22ch;
        text-wrap: balance;
        animation: fade-up 560ms cubic-bezier(0.22, 1, 0.36, 1) both 110ms;
    }

    .fault__accent {
        color: #85e7ff;
        text-shadow: 0 0 22px rgb(133 231 255 / 28%);
    }

    .fault__body {
        font-size: clamp(0.95rem, 2.4vw, 1.08rem);
        color: var(--color-text-secondary);
        line-height: 1.68;
        max-width: 46ch;
        text-wrap: pretty;
        animation: fade-up 520ms cubic-bezier(0.22, 1, 0.36, 1) both 190ms;
    }

    .fault__actions {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 0.85rem;
        margin-top: 0.5rem;
        animation: fade-up 480ms cubic-bezier(0.22, 1, 0.36, 1) both 270ms;
    }

    .fault__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        min-height: 3.9rem;
        padding: 0.95rem 1.8rem;
        border-radius: 0.95rem;
        border: 1px solid transparent;
        font-size: 1.03rem;
        font-weight: 650;
        text-decoration: none;
        transition:
            transform var(--transition-fast),
            box-shadow var(--transition-base),
            border-color var(--transition-fast),
            background var(--transition-fast);
    }

    .fault__btn:hover {
        transform: translateY(-2px);
    }

    .fault__btn:focus-visible {
        outline: 2px solid #85e7ff;
        outline-offset: 2px;
    }

    .fault__btn--primary {
        color: #1e0709;
        background: linear-gradient(135deg, #ff9ea2 0%, #ff7a81 55%, #ff9ea2 100%);
        box-shadow:
            0 12px 30px rgb(255 122 129 / 30%),
            inset 0 -1px 0 rgb(255 255 255 / 28%);
    }

    .fault__btn--secondary {
        color: #e7edf7;
        background: linear-gradient(180deg, rgb(20 25 33 / 80%) 0%, rgb(17 21 28 / 95%) 100%);
        border-color: rgb(255 255 255 / 0.12);
        box-shadow: 0 8px 18px rgb(0 0 0 / 30%);
    }

    .fault__btn--secondary:hover {
        border-color: rgb(133 231 255 / 45%);
        box-shadow: 0 14px 30px rgb(3 15 22 / 38%);
    }

    @keyframes fade-up {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes scan-drift {
        from {
            transform: translateY(-3%);
        }

        to {
            transform: translateY(3%);
        }
    }

    @keyframes pulse {
        0% {
            transform: translate(-50%, -50%) scale(0.35);
            opacity: 0.75;
        }

        100% {
            transform: translate(-50%, -50%) scale(2.8);
            opacity: 0;
        }
    }

    @keyframes glitch-shift {
        0%,
        100% {
            transform: translate(-50%, -50%);
        }

        12% {
            transform: translate(calc(-50% - 2px), calc(-50% + 1px));
        }

        13% {
            transform: translate(calc(-50% + 3px), calc(-50% - 1px));
        }

        14% {
            transform: translate(-50%, -50%);
        }

        37% {
            transform: translate(calc(-50% + 1px), calc(-50% + 2px));
        }

        38% {
            transform: translate(calc(-50% - 3px), calc(-50% - 1px));
        }

        39% {
            transform: translate(-50%, -50%);
        }
    }

    @mixin tablet-up {
        .fault__inner {
            padding-inline: 1.5rem;
            gap: 1.5rem;
        }

        .fault__actions {
            flex-direction: row;
            align-items: center;
            justify-content: center;
            width: auto;
        }

        .fault__btn {
            min-height: 3.7rem;
            border-radius: 0.85rem;
            font-size: 1.05rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .fault__badge,
        .fault__heading,
        .fault__body,
        .fault__actions,
        .fault__scan,
        .fault__code,
        .fault__pulse {
            animation: none;
        }

        .fault__btn {
            transition: none;
        }
    }
</style>
