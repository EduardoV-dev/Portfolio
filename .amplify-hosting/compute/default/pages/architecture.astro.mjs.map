---
export interface Props {
    iconName: "scalability" | "resilience" | "performance" | "maintainability";
    title: string;
    description: string;
    delay?: number;
}

const { iconName, title, description, delay = 1 } = Astro.props;
---

<li class="arch-pc" data-animate data-animate-delay={delay}>
    <div class="arch-pc__icon-box" aria-hidden="true">
        <span class="arch-pc__icon">
            {
                iconName === "scalability" && (
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M3 3v18h18" />
                        <path d="m7 16 4-4 4 4 4-4" />
                    </svg>
                )
            }
            {
                iconName === "resilience" && (
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                )
            }
            {
                iconName === "performance" && (
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                )
            }
            {
                iconName === "maintainability" && (
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                    </svg>
                )
            }
        </span>
    </div>
    <h3 class="arch-pc__title">{title}</h3>
    <p class="arch-pc__desc">{description}</p>
</li>

<style>
    @import "../../styles/mixins.css";

    .arch-pc {
        display: flex;
        flex-direction: column;
        padding: 1.75rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 1rem;
        transition:
            transform var(--transition-base),
            box-shadow var(--transition-base),
            border-color var(--transition-base);
        /* will-change removed from static rule — permanently holding a compositor
           layer on every card wastes GPU memory even when nothing is animating */
    }

    .arch-pc:hover {
        transform: translateY(-4px);
        box-shadow:
            0 0 0 1px color-mix(in srgb, var(--color-accent) 15%, transparent),
            0 16px 40px rgba(0, 0, 0, 0.45),
            0 0 32px color-mix(in srgb, var(--color-accent) 7%, transparent);
        border-color: color-mix(in srgb, var(--color-accent) 18%, transparent);
    }

    @mixin desktop-up {
        .arch-pc {
            padding: 2rem;
        }
    }

    /* ── Icon box ── */
    .arch-pc__icon-box {
        position: relative;
        flex-shrink: 0;
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 0.9rem;
        border: 1.5px solid color-mix(in srgb, var(--color-accent) 32%, transparent);
        background: linear-gradient(180deg, rgba(8, 14, 21, 0.97), rgba(6, 11, 18, 0.99));
        display: grid;
        place-items: center;
        margin-bottom: 1.5rem;
        box-shadow:
            0 0 0 1px rgba(255, 255, 255, 0.015) inset,
            0 8px 20px rgba(2, 7, 13, 0.45);
    }

    .arch-pc__icon-box::before {
        content: "";
        position: absolute;
        width: 60%;
        aspect-ratio: 1 / 1;
        border-radius: 50%;
        background: rgba(19, 65, 97, 0.55);
        pointer-events: none;
    }

    .arch-pc__icon {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-accent);
    }

    .arch-pc__icon svg {
        width: 1.35rem;
        height: 1.35rem;
    }

    /* ── Title ── */
    .arch-pc__title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-text-primary);
        letter-spacing: -0.02em;
        line-height: 1.3;
        margin-bottom: 0.85rem;
        text-wrap: balance;
    }

    @mixin desktop-up {
        .arch-pc__title {
            font-size: 1.05rem;
        }
    }

    /* ── Description ── */
    .arch-pc__desc {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
        line-height: 1.65;
    }

    @media (prefers-reduced-motion: reduce) {
        .arch-pc {
            transition: none;
        }
    }
</style>
