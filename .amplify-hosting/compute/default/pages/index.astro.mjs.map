---
import { YEARS_OF_PROFESSIONAL_EXPERIENCE } from "@/constants/common";
import HeroActions from "./hero-actions.astro";
---

<div class="hero-content">
    <p class="hero-status">OPEN TO NEW OPPORTUNITIES</p>

    <h1 class="hero-title">
        I turn product ideas
        <br />
        into polished,
        <br />
        <span>high-performing products.</span>
    </h1>

    <p class="hero-description">
        Full Stack Engineer with {YEARS_OF_PROFESSIONAL_EXPERIENCE}+ years building polished,
        high-performing digital products. I own the full stack from user-facing interfaces to cloud
        infrastructure, and bridge engineering, product, and marketing teams to ship software that
        moves business metrics.
    </p>

    <HeroActions />
</div>

<style>
    @import "../../../styles/mixins.css";

    .hero-content {
        display: flex;
        flex-direction: column;
        gap: 1.3rem;
        max-width: 100%;
    }

    .hero-status {
        align-self: flex-start;
        padding: 0.42rem 0.86rem;
        border-radius: 999px;
        border: 1px solid rgba(0, 204, 255, 0.4);
        color: var(--color-accent);
        font-size: 0.86rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        line-height: 1;
        background: linear-gradient(90deg, rgba(0, 204, 255, 0.13), rgba(0, 204, 255, 0.04));
        animation: hero-fade-up 500ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: 40ms;
    }

    .hero-status::before {
        content: "";
        display: inline-block;
        width: 0.45rem;
        height: 0.45rem;
        margin-right: 0.55rem;
        border-radius: 50%;
        background: var(--color-accent);
        box-shadow: 0 0 0 6px rgba(0, 204, 255, 0.12);
        vertical-align: middle;
    }

    .hero-title {
        font-size: clamp(2.2rem, 11vw, 3.2rem);
        line-height: 1;
        letter-spacing: -0.03em;
        font-weight: 700;
        font-optical-sizing: auto;
        color: #e9eef4;
        text-wrap: balance;
        animation: hero-fade-up 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: 120ms;
    }

    .hero-title span {
        color: #00ccff;
        text-shadow: 0 0 24px rgba(0, 204, 255, 0.2);
    }

    .hero-description {
        max-width: 100%;
        color: var(--color-text-secondary);
        font-size: clamp(1.07rem, 5.3vw, 1.3rem);
        line-height: 1.52;
        letter-spacing: -0.012em;
        text-wrap: pretty;
        animation: hero-fade-up 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: 200ms;
    }

    @mixin tablet-up {
        .hero-content {
            gap: 1.65rem;
        }

        .hero-title {
            line-height: 1;
            font-size: clamp(2.35rem, 11.8vw, 3.75rem);
        }

        .hero-status {
            font-size: 0.95rem;
            letter-spacing: 0.02em;
            padding: 0.42rem 1rem;
        }

        .hero-description {
            font-size: clamp(1.08rem, 3.2vw, 1.3rem);
        }
    }

    @mixin desktop-up {
        .hero-content {
            max-width: 38rem;
        }

        .hero-title {
            font-size: clamp(2.45rem, 3.8vw, 3.8rem);
            line-height: 1;
        }

        .hero-description {
            max-width: 34rem;
            font-size: clamp(1rem, 1.1vw, 1.15rem);
            line-height: 1.6;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-status,
        .hero-title,
        .hero-description {
            animation: none;
        }
    }

    @keyframes hero-fade-up {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
