    import { initScrollReveal } from "@/utils/animations";
    initScrollReveal();

    // ── Filter logic ──
    const buttons = document.querySelectorAll<HTMLButtonElement>(".csw-filter-btn");
    const emptyState = document.getElementById("csw-empty")!;

    function applyFilter(category: string) {
        const cards = document.querySelectorAll<HTMLElement>("[data-categories]");
        let visibleCount = 0;

        cards.forEach((card) => {
            const categoryValues = (card.dataset.categories ?? "")
                .split(",")
                .filter((value) => value.length > 0);
            const matches = category === "all" || categoryValues.includes(category);
            if (matches) {
                card.classList.remove("csw-card-hidden");
                visibleCount++;
            } else {
                card.classList.add("csw-card-hidden");
            }
        });

        emptyState.hidden = visibleCount > 0;
    }

