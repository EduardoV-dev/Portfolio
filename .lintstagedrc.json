{
    "apps/frontend/**/*.{js,ts,jsx,tsx,mjs,astro}": [
        "pnpm --filter apps-frontend exec eslint",
        "pnpm --filter apps-frontend exec prettier --check"
    ],
    "apps/frontend/**/*.{json,css}": ["pnpm --filter apps-frontend exec prettier --check"],
    "apps/frontend/**/*.{ts,tsx,astro}": ["pnpm --filter apps-frontend typecheck"]
}
