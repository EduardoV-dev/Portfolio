---
export interface Props {
    title: string;
    description: string;
    tags: string[];
    impact: { icon: string; text: string }[];
    tech: string[];
    href?: string;
}

const { title, description, tags, impact, tech, href = "#" } = Astro.props;
---

<article class="cs-card">
    <!-- Browser mockup image -->
    <div class="cs-card__image" aria-hidden="true">
        <div class="cs-card__browser">
            <div class="cs-card__browser-bar">
                <span class="cs-card__dot cs-card__dot--red"></span>
                <span class="cs-card__dot cs-card__dot--yellow"></span>
                <span class="cs-card__dot cs-card__dot--green"></span>
                <div class="cs-card__url-bar"></div>
            </div>
            <div class="cs-card__browser-body"></div>
            <div class="cs-card__browser-footer"></div>
        </div>
    </div>

    <!-- Content panel -->
    <div class="cs-card__content">
        <!-- Tags -->
        <div class="cs-card__tags">
            {
                tags.map((tag, i) => (
                    <span class:list={["cs-card__tag", i === 0 && "cs-card__tag--accent"]}>
                        {tag}
                    </span>
                ))
            }
        </div>

        <!-- Title -->
        <h3 class="cs-card__title">{title}</h3>

        <!-- Description (desktop only) -->
        <p class="cs-card__desc">{description}</p>

        <!-- Impact (desktop only) -->
        <div class="cs-card__impact">
            <p class="cs-card__impact-label">Impact</p>
            <ul class="cs-card__impact-list" role="list">
                {
                    impact.map((item) => (
                        <li class="cs-card__impact-item">
                            <span aria-hidden="true">{item.icon}</span>
                            {item.text}
                        </li>
                    ))
                }
            </ul>
        </div>

        <!-- Tech pills (desktop only) -->
        <ul class="cs-card__tech" role="list" aria-label="Technologies used">
            {tech.map((t) => <li class="cs-card__tech-pill">{t}</li>)}
        </ul>

        <!-- CTA -->
        <a href={href} class="cs-card__cta" aria-label={`Case study details for ${title}`}>
            Case Study Details &rarr;
        </a>
    </div>
</article>

<style>
    @import "../../../styles/mixins.css";

    /* ── Card shell ── */
    .cs-card {
        display: flex;
        flex-direction: column;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 1rem;
        overflow: hidden;
    }

    @mixin desktop-up {
        .cs-card {
            flex-direction: row;
            align-items: stretch;
            border-radius: 1rem;
        }
    }

    /* ── Browser mockup ── */
    .cs-card__image {
        flex-shrink: 0;
        background: #1a1a1a;
    }

    @mixin desktop-up {
        .cs-card__image {
            width: 50%;
        }
    }

    .cs-card__browser {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 220px;
        background: #d4d4d4;
        border-radius: 0;
    }

    @mixin desktop-up {
        .cs-card__browser {
            min-height: 360px;
        }
    }

    .cs-card__browser-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 0.85rem;
        background: #e8e8e8;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        flex-shrink: 0;
    }

    .cs-card__dot {
        display: inline-block;
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .cs-card__dot--red {
        background: #ff5f57;
    }

    .cs-card__dot--yellow {
        background: #febc2e;
    }

    .cs-card__dot--green {
        background: #28c840;
    }

    .cs-card__url-bar {
        flex: 1;
        height: 1.1rem;
        background: rgba(0, 0, 0, 0.1);
        border-radius: 0.3rem;
        margin-left: 0.4rem;
    }

    .cs-card__browser-body {
        flex: 1;
        background: #e2e2e2;
        position: relative;
    }

    .cs-card__browser-footer {
        flex-shrink: 0;
        height: 2.75rem;
        background: #e8e8e8;
        border-top: 1px solid rgba(0, 0, 0, 0.08);
        display: flex;
        align-items: center;
        padding-inline: 0.85rem;
        gap: 0.5rem;
    }

    .cs-card__browser-footer::before {
        content: "";
        display: block;
        width: 55%;
        height: 0.7rem;
        background: rgba(0, 0, 0, 0.12);
        border-radius: 0.25rem;
    }

    .cs-card__browser-footer::after {
        content: "";
        display: block;
        width: 4rem;
        height: 1.4rem;
        background: rgba(0, 0, 0, 0.13);
        border-radius: 0.3rem;
        margin-left: auto;
    }

    /* ── Content panel ── */
    .cs-card__content {
        display: flex;
        flex-direction: column;
        gap: 0;
        padding: 1.5rem;
    }

    @mixin desktop-up {
        .cs-card__content {
            width: 50%;
            padding: 2.25rem 2.5rem;
            justify-content: center;
        }
    }

    /* ── Tags ── */
    .cs-card__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .cs-card__tag {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.25rem 0.65rem;
        border-radius: 0.35rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.05);
        color: var(--color-text-secondary);
    }

    .cs-card__tag--accent {
        background: rgba(56, 189, 248, 0.12);
        border-color: rgba(56, 189, 248, 0.3);
        color: var(--color-accent);
    }

    /* ── Title ── */
    .cs-card__title {
        font-size: clamp(1.25rem, 4vw, 1.6rem);
        font-weight: 700;
        color: var(--color-text-primary);
        letter-spacing: -0.03em;
        line-height: 1.2;
        margin-bottom: 1rem;
    }

    /* ── Description (hidden on mobile) ── */
    .cs-card__desc {
        display: none;
        font-size: 0.95rem;
        color: var(--color-text-secondary);
        line-height: 1.65;
        margin-bottom: 1.5rem;
    }

    @mixin desktop-up {
        .cs-card__desc {
            display: block;
        }
    }

    /* ── Impact (hidden on mobile) ── */
    .cs-card__impact {
        display: none;
        margin-bottom: 1.5rem;
    }

    @mixin desktop-up {
        .cs-card__impact {
            display: block;
        }
    }

    .cs-card__impact-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-text-primary);
        margin-bottom: 0.5rem;
    }

    .cs-card__impact-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .cs-card__impact-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.88rem;
        color: var(--color-text-secondary);
        line-height: 1.4;
    }

    /* ── Tech pills (hidden on mobile) ── */
    .cs-card__tech {
        display: none;
        list-style: none;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 1.75rem;
    }

    @mixin desktop-up {
        .cs-card__tech {
            display: flex;
        }
    }

    .cs-card__tech-pill {
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--color-text-secondary);
        padding: 0.25rem 0.7rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.35rem;
        background: transparent;
        transition:
            border-color var(--transition-fast),
            color var(--transition-fast);
    }

    .cs-card__tech-pill:hover {
        border-color: rgba(56, 189, 248, 0.35);
        color: var(--color-text-primary);
    }

    /* ── CTA ── */
    .cs-card__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--color-accent);
        text-decoration: none;
        transition: color var(--transition-fast);
        margin-top: auto;
    }

    .cs-card__cta:hover {
        color: var(--color-accent-hover);
    }

    @mixin desktop-up {
        .cs-card__cta {
            margin-top: 0;
        }
    }
</style>
