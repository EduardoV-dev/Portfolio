---
import { type Post, formatPostDate } from "@/data/posts";

interface Props {
    post: Post;
}

const { post } = Astro.props;
const displayDate = formatPostDate(post.date);
---

<section class="if" aria-labelledby="if-heading">
    <div class="if__inner">
        <p class="if__section-label">FEATURED ARTICLE</p>

        <a href={`/blog/${post.slug}`} class="if__card" data-animate>
            <div class="if__card-image" aria-hidden="true">
                <div class="if__card-image-pattern"></div>
                <span class="if__featured-badge">Featured</span>
            </div>

            <div class="if__card-body">
                <div class="if__card-tags" aria-label="Tags">
                    {post.tags.slice(0, 3).map((tag) => <span class="if__tag">{tag}</span>)}
                </div>

                <h2 class="if__card-title" id="if-heading">{post.title}</h2>

                <p class="if__card-desc">{post.description}</p>

                <div class="if__card-meta">
                    <span class="if__meta-date">{displayDate}</span>
                    <span class="if__meta-sep" aria-hidden="true">·</span>
                    <span class="if__meta-time">{post.readingTime} min read</span>
                </div>

                <span class="if__card-cta">
                    Read Article <span aria-hidden="true">→</span>
                </span>
            </div>
        </a>
    </div>
</section>

<style>
    @import "../../styles/mixins.css";

    .if {
        position: relative;
        z-index: 1;
        padding-block: 1rem 3rem;
    }

    .if__inner {
        max-width: 1280px;
        margin: 0 auto;
        padding-inline: 1rem;
    }

    .if__section-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
        opacity: 0.6;
        margin-bottom: 1rem;
    }

    /* ── Card ── */
    .if__card {
        display: block;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        transition:
            transform var(--transition-base),
            border-color var(--transition-base),
            box-shadow var(--transition-base);
    }

    .if__card:hover {
        transform: translateY(-3px);
        border-color: rgba(56, 189, 248, 0.25);
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
    }

    .if__card:hover .if__card-title {
        color: var(--color-accent);
    }

    .if__card:hover .if__card-image-pattern {
        opacity: 0.75;
    }

    .if__card:focus-visible {
        outline: 2px solid rgba(56, 189, 248, 0.9);
        outline-offset: 2px;
    }

    /* ── Image placeholder ── */
    .if__card-image {
        position: relative;
        width: 100%;
        height: 200px;
        background: linear-gradient(135deg, #0d1117 0%, #111827 50%, #0f172a 100%);
        overflow: hidden;
        flex-shrink: 0;
    }

    .if__card-image-pattern {
        position: absolute;
        inset: 0;
        opacity: 0.5;
        background-image:
            radial-gradient(circle at 30% 40%, rgba(56, 189, 248, 0.12) 0%, transparent 55%),
            radial-gradient(circle at 75% 65%, rgba(56, 189, 248, 0.08) 0%, transparent 45%),
            linear-gradient(rgba(56, 189, 248, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(56, 189, 248, 0.04) 1px, transparent 1px);
        background-size:
            auto,
            auto,
            40px 40px,
            40px 40px;
        transition: opacity var(--transition-base);
    }

    .if__featured-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-accent);
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.2);
        border-radius: 4px;
        padding: 0.25rem 0.6rem;
    }

    /* ── Body ── */
    .if__card-body {
        padding: 1.5rem;
    }

    .if__card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 0.875rem;
    }

    .if__tag {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-accent);
        background: rgba(56, 189, 248, 0.08);
        border: 1px solid rgba(56, 189, 248, 0.15);
        border-radius: 4px;
        padding: 0.2rem 0.55rem;
    }

    .if__card-title {
        font-size: clamp(1.4rem, 3.5vw, 2rem);
        font-weight: 760;
        letter-spacing: -0.03em;
        color: var(--color-text-primary);
        line-height: 1.2;
        margin-bottom: 0.875rem;
        transition: color var(--transition-fast);
    }

    .if__card-desc {
        font-size: clamp(0.9rem, 2vw, 1rem);
        color: var(--color-text-secondary);
        line-height: 1.7;
        margin-bottom: 1.25rem;
    }

    .if__card-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: var(--color-text-secondary);
        opacity: 0.7;
        margin-bottom: 1.25rem;
    }

    .if__card-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-accent);
        transition: gap var(--transition-fast);
    }

    .if__card:hover .if__card-cta {
        gap: 0.55rem;
    }

    @mixin tablet-up {
        .if__inner {
            padding-inline: 1.5rem;
        }

        .if__card {
            display: grid;
            grid-template-columns: 340px 1fr;
        }

        .if__card-image {
            height: auto;
            min-height: 280px;
        }

        .if__card-body {
            padding: 2rem 2.25rem;
        }

        .if__card-title {
            margin-bottom: 1rem;
        }
    }

    @mixin desktop-up {
        .if__card {
            grid-template-columns: 420px 1fr;
        }

        .if__card-body {
            padding: 2.5rem 2.75rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .if__card,
        .if__card-title,
        .if__card-image-pattern,
        .if__card-cta {
            transition: none;
        }
    }
</style>

<script>
    import { initScrollReveal } from "@/utils/animations";
    initScrollReveal();
</script>
