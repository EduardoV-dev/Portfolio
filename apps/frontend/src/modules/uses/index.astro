---
interface Tool {
    name: string;
    description: string;
    icon: string;
}

interface Category {
    label: string;
    sectionLabel: string;
    tools: Tool[];
}

const categories: Category[] = [
    {
        label: "LANGUAGES",
        sectionLabel: "languages",
        tools: [
            {
                name: "TypeScript",
                description:
                    "Primary language for all frontend and backend work. Strict mode always on — type errors at compile time, not runtime.",
                icon: "ts",
            },
            {
                name: "Go",
                description:
                    "Used for performance-critical backend services. Excellent concurrency primitives, fast compile times, and a minimal stdlib.",
                icon: "go",
            },
        ],
    },
    {
        label: "FRONTEND",
        sectionLabel: "frontend",
        tools: [
            {
                name: "Astro 5",
                description:
                    "Static-first framework for content and portfolio sites. Zero JS by default, island architecture for selective hydration.",
                icon: "astro",
            },
            {
                name: "React 19",
                description:
                    "Component model for interactive UIs. Used as Astro islands and standalone SPAs. Server Components where applicable.",
                icon: "react",
            },
            {
                name: "Zustand 5",
                description:
                    "Minimal, unopinionated client state. Replaces Redux for almost every use case with a fraction of the boilerplate.",
                icon: "zustand",
            },
            {
                name: "Embla Carousel",
                description:
                    "Lightweight, framework-agnostic carousel engine. Handles touch, mouse, and pointer events with smooth physics.",
                icon: "embla",
            },
        ],
    },
    {
        label: "BACKEND",
        sectionLabel: "backend",
        tools: [
            {
                name: "Node.js",
                description:
                    "Runtime for TypeScript-based API servers, scripts, and tooling. Pairs with Fastify or raw HTTP for high-throughput services.",
                icon: "node",
            },
        ],
    },
    {
        label: "CLOUD & INFRA",
        sectionLabel: "cloud",
        tools: [
            {
                name: "AWS S3",
                description:
                    "Object storage for static site hosting, asset uploads, and data archival. Versioned buckets for rollback safety.",
                icon: "s3",
            },
            {
                name: "AWS CloudFront",
                description:
                    "Global CDN for edge-cached delivery. Cache invalidation on deploy, custom error pages, and HTTPS termination.",
                icon: "cf",
            },
            {
                name: "OIDC (GitHub Actions)",
                description:
                    "Keyless AWS authentication from CI. Short-lived tokens scoped per workflow — no long-lived secrets stored anywhere.",
                icon: "oidc",
            },
        ],
    },
    {
        label: "TOOLING",
        sectionLabel: "tooling",
        tools: [
            {
                name: "pnpm",
                description:
                    "Fast, disk-efficient package manager. Workspace support for monorepos, strict hoisting, and deterministic installs.",
                icon: "pnpm",
            },
            {
                name: "ESLint",
                description:
                    "Static analysis with layered configs. Catches logic bugs, enforces import conventions, and prevents accessibility regressions.",
                icon: "eslint",
            },
            {
                name: "Prettier",
                description:
                    "Opinionated formatter across the entire monorepo. Consistent style enforced at commit time — no debates.",
                icon: "prettier",
            },
            {
                name: "Husky + lint-staged",
                description:
                    "Pre-commit hooks that run lint, format checks, and full build on staged files. Broken code cannot enter the repo.",
                icon: "husky",
            },
        ],
    },
];
---

<section class="uses-hero" aria-labelledby="uses-hero-heading">
    <div class="uses-hero__inner">
        <p class="uses-hero__label">USES</p>
        <h1 class="uses-hero__title" id="uses-hero-heading">
            My <span class="uses-hero__accent">Stack</span>
        </h1>
        <p class="uses-hero__subtext">
            The languages, frameworks, tools, and cloud services I reach for in production. Updated
            as my setup evolves.
        </p>
    </div>
</section>

{
    categories.map((cat) => (
        <section class="uses-cat" aria-labelledby={`uses-cat-${cat.sectionLabel}-heading`}>
            <div class="uses-cat__inner">
                <header class="uses-cat__header">
                    <p class="uses-cat__label" data-animate data-animate-delay="1">
                        {cat.label}
                    </p>
                </header>
                <ul class="uses-cat__grid" role="list">
                    {cat.tools.map((tool, i) => (
                        <li class="uses-card" data-animate data-animate-delay={i + 1}>
                            <div class="uses-card__icon-box" aria-hidden="true">
                                <span class="uses-card__monogram">
                                    {tool.icon.slice(0, 2).toUpperCase()}
                                </span>
                            </div>
                            <h3 class="uses-card__name">{tool.name}</h3>
                            <p class="uses-card__desc">{tool.description}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    ))
}

<style>
    @import "../../styles/mixins.css";

    /* ── Hero ── */
    .uses-hero {
        position: relative;
        z-index: 1;
        padding-block: 5rem 4rem;
    }

    .uses-hero__inner {
        max-width: 1280px;
        margin: 0 auto;
        padding-inline: 1rem;
    }

    @mixin tablet-up {
        .uses-hero__inner {
            padding-inline: 1.5rem;
        }
    }

    @mixin desktop-up {
        .uses-hero {
            padding-block: 6rem 4.5rem;
        }
    }

    .uses-hero__label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: 1rem;
        animation: uses-fade-up 500ms ease both;
        animation-delay: 40ms;
    }

    .uses-hero__title {
        font-size: clamp(2.25rem, 8vw, 4rem);
        font-weight: 800;
        letter-spacing: -0.05em;
        color: var(--color-text-primary);
        line-height: 1.05;
        margin-bottom: 1.5rem;
        animation: uses-fade-up 560ms ease both;
        animation-delay: 120ms;
    }

    .uses-hero__accent {
        color: var(--color-accent);
    }

    .uses-hero__subtext {
        font-size: clamp(1rem, 2.5vw, 1.15rem);
        color: var(--color-text-secondary);
        line-height: 1.65;
        max-width: 46ch;
        animation: uses-fade-up 520ms ease both;
        animation-delay: 200ms;
    }

    @media (prefers-reduced-motion: reduce) {
        .uses-hero__label,
        .uses-hero__title,
        .uses-hero__subtext {
            animation: none;
        }
    }

    /* ── Category sections ── */
    .uses-cat {
        position: relative;
        z-index: 1;
        padding-block: 3rem;
    }

    .uses-cat:not(:last-of-type) {
        border-bottom: 1px solid var(--color-border);
    }

    .uses-cat__inner {
        max-width: 1280px;
        margin: 0 auto;
        padding-inline: 1rem;
    }

    @mixin tablet-up {
        .uses-cat__inner {
            padding-inline: 1.5rem;
        }
    }

    .uses-cat__header {
        margin-bottom: 2rem;
    }

    .uses-cat__label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-accent);
    }

    /* ── Grid ── */
    .uses-cat__grid {
        list-style: none;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    @mixin tablet-up {
        .uses-cat__grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.25rem;
        }
    }

    @mixin desktop-up {
        .uses-cat__grid {
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }
    }

    /* ── Card ── */
    .uses-card {
        display: flex;
        flex-direction: column;
        padding: 1.75rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 1rem;
        transition:
            transform var(--transition-base),
            box-shadow var(--transition-base),
            border-color var(--transition-base);
    }

    .uses-card:hover {
        will-change: transform;
        transform: translateY(-4px);
        box-shadow:
            0 0 0 1px rgba(56, 189, 248, 0.15),
            0 16px 40px rgba(0, 0, 0, 0.45),
            0 0 32px rgba(56, 189, 248, 0.07);
        border-color: rgba(56, 189, 248, 0.18);
    }

    @mixin desktop-up {
        .uses-card {
            padding: 2rem;
        }
    }

    /* ── Icon box ── */
    .uses-card__icon-box {
        flex-shrink: 0;
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 0.9rem;
        border: 1.5px solid rgba(56, 189, 248, 0.32);
        background: linear-gradient(180deg, rgba(8, 14, 21, 0.97), rgba(6, 11, 18, 0.99));
        display: grid;
        place-items: center;
        margin-bottom: 1.5rem;
        box-shadow:
            0 0 0 1px rgba(255, 255, 255, 0.015) inset,
            0 8px 20px rgba(2, 7, 13, 0.45);
    }

    .uses-card__monogram {
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.03em;
        color: var(--color-accent);
        font-family: var(--font-mono, monospace);
    }

    /* ── Text ── */
    .uses-card__name {
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-text-primary);
        letter-spacing: -0.02em;
        line-height: 1.3;
        margin-bottom: 0.85rem;
    }

    @mixin desktop-up {
        .uses-card__name {
            font-size: 1.05rem;
        }
    }

    .uses-card__desc {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
        line-height: 1.65;
    }

    @media (prefers-reduced-motion: reduce) {
        .uses-card {
            transition: none;
        }
    }

    @keyframes uses-fade-up {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    import { initScrollReveal } from "@/utils/animations";
    initScrollReveal();
</script>
