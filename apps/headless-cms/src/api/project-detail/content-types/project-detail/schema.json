{
  "kind": "collectionType",
  "collectionName": "project_details",
  "info": {
    "singularName": "project-detail",
    "pluralName": "project-details",
    "displayName": "Project Detail"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "metrics": {
      "type": "component",
      "component": "project.metric",
      "repeatable": true,
      "required": true
    },
    "overview": {
      "type": "text",
      "required": true
    },
    "challenge": {
      "type": "text",
      "required": true
    },
    "solution": {
      "type": "text",
      "required": true
    },
    "highlights": {
      "type": "component",
      "component": "project.highlight",
      "repeatable": true
    },
    "technologies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::technology.technology"
    },
    "impactDetails": {
      "type": "json",
      "required": true
    },
    "learnings": {
      "type": "json",
      "required": true
    }
  }
}
