# ──────────────────────────────────────────────
# Frontend environment variables
# Copy to .env and fill in real values.
# Never commit .env to version control.
# ──────────────────────────────────────────────

# ---------------------------------------------------------------------------
# Build-time (server-only — not exposed to the browser)
# ---------------------------------------------------------------------------

# Canonical site URL used for SEO / Open Graph meta tags.
# No trailing slash. Change to your production domain before deploying.
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Client-accessible (PUBLIC_ prefix — safe to expose in browser bundles)
# ---------------------------------------------------------------------------

# Web3Forms access key — receives contact form submissions via email.
# Register your email at https://web3forms.com to get a free key.
PUBLIC_WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY

# Google reCAPTCHA v3 site key — invisible spam protection on the contact form.
# Create a v3 site key at https://www.google.com/recaptcha/admin
# Add this domain (and localhost) to the allowed domains list.
PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY
