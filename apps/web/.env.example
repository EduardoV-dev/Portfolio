# -----------------------------
# Public client vars (browser bundle)
# Create in: GitHub Variables
# -----------------------------
PUBLIC_ENVIRONMENT=staging
PUBLIC_SITE_URL=https://stg.eduardov.dev
PUBLIC_GA_MEASUREMENT_ID=YOUR_GA4_MEASUREMENT_ID
PUBLIC_SENTRY_ENABLED=true
PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
PUBLIC_WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY

# -----------------------------
# Sentry build/server vars
# Create in: GitHub Variables + Cloudflare Worker vars
# -----------------------------
SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_RELEASE=portfolio@1.0.0
SENTRY_ENVIRONMENT=staging
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_DEBUG=false

# Create in: GitHub Variables only
SENTRY_ORG=YOUR_SENTRY_ORG
SENTRY_PROJECT=YOUR_SENTRY_PROJECT

# Create in: GitHub Secrets only
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN

# -----------------------------
# Strapi content fetch vars
# Create in: GitHub Variables/Secrets + Cloudflare Worker bindings
# -----------------------------
STRAPI_CMS_OPTIONAL=false
STRAPI_API_URL=https://your-strapi-host.example/api
STRAPI_API_TOKEN=YOUR_TOKEN

# -----------------------------
# Cloudflare runtime-only vars/secrets
# Used by /api/strapi-rebuild endpoint
# -----------------------------
# Create in: Cloudflare Worker Secrets
STRAPI_WEBHOOK_SECRET=YOUR_STRAPI_WEBHOOK_SECRET
GITHUB_ACTIONS_TOKEN=YOUR_GITHUB_ACTIONS_TOKEN

# Create in: Cloudflare Worker vars
GITHUB_REPO_OWNER=EduardoV-dev
GITHUB_REPO_NAME=portfolio
GITHUB_REBUILD_WORKFLOW_FILE=deploy-staging.yml
GITHUB_REBUILD_REF=staging
