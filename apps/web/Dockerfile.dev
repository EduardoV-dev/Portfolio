FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Install deps as a separate layer so it's cached unless package.json changes.
# Source files are volume-mounted at runtime for hot reload.
COPY package.json ./
RUN pnpm install

# Expose Astro's default dev port
EXPOSE 4321

CMD ["pnpm", "dev", "--host", "0.0.0.0"]
