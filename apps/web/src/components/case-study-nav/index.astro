---
export interface NavItem {
    id: string;
    label: string;
}

export interface Props {
    items: NavItem[];
    backHref?: string;
}

const { items, backHref = "/case-studies" } = Astro.props;
---

<nav class="csn-nav" aria-label="Case study sections">
    <!-- Back link -->
    <a href={backHref} class="csn-nav__back">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M19 12H5M12 5l-7 7 7 7"></path>
        </svg>
        All Case Studies
    </a>

    <!-- Section list -->
    <ul class="csn-nav__list" role="list">
        {
            items.map((item) => (
                <li class="csn-nav__item">
                    <a
                        href={`#${item.id}`}
                        class="csn-nav__link"
                        data-nav-id={item.id}
                        aria-current="false"
                    >
                        <span class="csn-nav__indicator" aria-hidden="true" />
                        {item.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style>
    @import "../../styles/mixins.css";

    /* Hidden on mobile, shown on desktop */
    .csn-nav {
        display: none;
    }

    @mixin desktop-up {
        .csn-nav {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            position: sticky;
            top: calc(var(--header-height, 68px) + 2rem);
            width: 200px;
            flex-shrink: 0;
            align-self: flex-start;
        }
    }

    /* Back link */
    .csn-nav__back {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--color-text-secondary);
        text-decoration: none;
        text-transform: uppercase;
        transition: color var(--transition-fast);
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--color-border);
    }

    .csn-nav__back:hover {
        color: var(--color-text-primary);
    }

    .csn-nav__back:focus-visible {
        outline: 2px solid rgba(56, 189, 248, 0.9);
        outline-offset: 3px;
        border-radius: 2px;
    }

    /* List */
    .csn-nav__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    /* Link */
    .csn-nav__link {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--color-text-secondary);
        text-decoration: none;
        padding: 0.35rem 0;
        line-height: 1.4;
        transition: color var(--transition-fast);
        border-radius: 3px;
    }

    .csn-nav__link:hover {
        color: var(--color-text-primary);
    }

    .csn-nav__link:focus-visible {
        outline: 2px solid rgba(56, 189, 248, 0.9);
        outline-offset: 3px;
    }

    /* Active state */
    .csn-nav__link.is-active {
        color: var(--color-accent);
    }

    /* Indicator dot/line */
    .csn-nav__indicator {
        display: inline-block;
        width: 2px;
        height: 14px;
        border-radius: 2px;
        background: var(--color-border);
        flex-shrink: 0;
        transition:
            background var(--transition-fast),
            height var(--transition-fast);
    }

    .csn-nav__link.is-active .csn-nav__indicator {
        background: var(--color-accent);
        height: 18px;
    }
</style>

<script>
    // Active section tracking via IntersectionObserver
    const links = document.querySelectorAll<HTMLAnchorElement>(".csn-nav__link[data-nav-id]");

    if (links.length) {
        const sectionMap = new Map<string, HTMLAnchorElement>();
        links.forEach((link) => {
            const id = link.dataset.navId!;
            sectionMap.set(id, link);
        });

        let activeId: string | null = null;

        const observer = new IntersectionObserver(
            (entries) => {
                // Find topmost visible section
                const visible = entries
                    .filter((e) => e.isIntersecting)
                    .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

                if (visible.length === 0) return;

                const newId = visible[0].target.id;
                if (newId === activeId) return;

                // Clear previous
                if (activeId) {
                    const prev = sectionMap.get(activeId);
                    prev?.setAttribute("aria-current", "false");
                    prev?.classList.remove("is-active");
                }
                // Set new
                activeId = newId;
                const next = sectionMap.get(activeId);
                next?.setAttribute("aria-current", "true");
                next?.classList.add("is-active");
            },
            {
                rootMargin: "-10% 0px -60% 0px",
                threshold: 0,
            },
        );

        sectionMap.forEach((_, id) => {
            const el = document.getElementById(id);
            if (el) observer.observe(el);
        });
    }
</script>
