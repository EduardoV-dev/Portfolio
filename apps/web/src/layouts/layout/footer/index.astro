---
import FooterBrand from "./footer-brand.astro";
import FooterNav from "./footer-nav.astro";
import FooterBottom from "./footer-bottom.astro";
---

<footer class="footer" id="site-footer" aria-label="Site footer">
    <div class="footer__inner">
        <div class="footer__top">
            <FooterBrand />
            <FooterNav />
        </div>
        <FooterBottom />
    </div>
</footer>

<style>
    @import "../../../styles/mixins.css";

    .footer {
        background: linear-gradient(180deg, rgba(8, 14, 22, 0.54) 0%, rgba(8, 14, 22, 0.68) 100%);
        border-top: 1px solid rgba(126, 164, 193, 0.22);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(14px) saturate(132%);
        -webkit-backdrop-filter: blur(14px) saturate(132%);
    }

    .footer__inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .footer__top {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        padding: 2.5rem 0 2rem;
    }

    @mixin tablet-up {
        .footer__top {
            grid-template-columns: 1.5fr 1fr 1fr 1fr;
            gap: 3rem;
            padding: 4rem 0 3rem;
        }
    }
</style>
