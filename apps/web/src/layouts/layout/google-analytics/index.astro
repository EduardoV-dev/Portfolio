---
import { ENVS } from "@/constants/environment-variables";

const measurementId = ENVS.PUBLIC_GA_MEASUREMENT_ID;
const isEnabled = Boolean(measurementId);
---

{
    isEnabled && (
        <>
            <script
                is:inline
                type="text/partytown"
                src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}
            />
            <script
                is:inline
                type="text/partytown"
                data-ga-measurement-id={measurementId}
                id="ga-init"
            >
                const measurementId =
                document.getElementById('ga-init').getAttribute('data-ga-measurement-id');
                window.dataLayer = window.dataLayer || []; function gtag()
                {
                    dataLayer.push(arguments) // eslint-disable-line
                }
                gtag('js', new Date()); gtag('config', measurementId);
            </script>
        </>
    )
}
