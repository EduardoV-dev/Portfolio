---
import Header from "./header/index.tsx";
import Footer from "./footer/index.astro";
import { ENVS } from "@/constants/environment-variables";
import "@/styles/global.css";

interface Props {
    title?: string;
    description?: string;
    canonical?: string;
    robots?: string;
    ogImage?: string;
    ogType?: "website" | "article";
}

const {
    title = "Eduardo Varela – Full Stack Engineer",
    description = "Personal portfolio of Eduardo Varela, Full Stack Engineer.",
    canonical,
    robots = "index,follow",
    ogImage = "/favicon/android-chrome-512x512.png",
    ogType = "website",
} = Astro.props;

const SITE_NAME = "Eduardo Varela";
const gaMeasurementId = ENVS.PUBLIC_GA_MEASUREMENT_ID;
const environment = ENVS.PUBLIC_ENVIRONMENT;
const isProduction = environment === "production";
const siteUrl = ENVS.PUBLIC_SITE_URL.replace(/\/$/, "");
const effectiveRobots = isProduction ? robots : "noindex, nofollow";
const canonicalPath = canonical ?? Astro.url.pathname;
const canonicalUrl = canonicalPath.startsWith("http")
    ? canonicalPath
    : `${siteUrl}${canonicalPath.startsWith("/") ? canonicalPath : `/${canonicalPath}`}`;
const ogImageUrl = ogImage.startsWith("http")
    ? ogImage
    : `${siteUrl}${ogImage.startsWith("/") ? ogImage : `/${ogImage}`}`;
---

<!doctype html>
<html lang="en" style="color-scheme: dark;">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#05080c" />
        <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
        <link rel="manifest" href="/favicon/site.webmanifest" />
        <!-- Font preconnect + preload -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap"
        />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap"
        />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta name="robots" content={effectiveRobots} />
        <link rel="canonical" href={canonicalUrl} />

        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImageUrl} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        {
            gaMeasurementId && (
                <>
                    <script
                        is:inline
                        async
                        src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
                    />
                    <script is:inline define:vars={{ gaMeasurementId }}>
                        window.dataLayer = window.dataLayer ?? []; window.dataLayer.push(["js", new
                        Date()]); window.dataLayer.push([ "config", gaMeasurementId, ]);
                    </script>
                </>
            )
        }
        <title>{title}</title>
        <script is:inline type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "Person",
                        "name": "Eduardo Varela",
                        "url": "https://eduardov.dev",
                        "jobTitle": "Full Stack Engineer",
                        "sameAs": [
                            "https://www.linkedin.com/in/eduardov-dev",
                            "https://github.com/EduardoV-dev"
                        ]
                    },
                    {
                        "@type": "WebSite",
                        "name": "Eduardo Varela",
                        "url": "https://eduardov.dev",
                        "inLanguage": "en"
                    }
                ]
            }
        </script>
    </head>
    <body>
        <div class="site-ambient" aria-hidden="true">
            <span class="site-ambient__layer site-ambient__layer--one"></span>
            <span class="site-ambient__layer site-ambient__layer--two"></span>
        </div>

        <a href="#main-content" class="skip-nav">Skip to main content</a>

        <div class="site-shell">
            <Header currentPath={Astro.url.pathname} client:load />
            <main id="main-content" style="padding-top: calc(var(--header-height, 72px) + 1.5rem);">
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>

<style>
    .site-shell {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .skip-nav {
        position: absolute;
        top: -100%;
        left: 1rem;
        z-index: 9999;
        padding: 0.375rem 1rem;
        background: var(--color-accent);
        color: var(--color-cta-text);
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 0.875rem;
        border-radius: 0 0 6px 6px;
        transition: top 150ms var(--ease-out-quint);
        text-decoration: none;
    }

    .skip-nav:focus-visible {
        top: 0;
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
    }
</style>
