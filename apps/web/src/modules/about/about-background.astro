---
import { YEARS_OF_PROFESSIONAL_EXPERIENCE } from "@/constants/common";
---

<section class="about-bg" aria-labelledby="about-bg-heading">
    <div class="about-bg__inner layout-container">
        <header class="about-bg__header">
            <p class="about-bg__label section-kicker" data-animate data-animate-delay="1">
                Professional background
            </p>
            <h2 class="about-bg__heading" id="about-bg-heading" data-animate data-animate-delay="2">
                How I Got Here
            </h2>
        </header>

        <div class="about-bg__prose">
            <p class="about-bg__para" data-animate data-animate-delay="1">
                I started in frontend and moved into full-stack work to own delivery from UI to API
                to cloud. That shift pushed me into cross-functional work with engineering, product,
                and marketing.
            </p>
            <p class="about-bg__para" data-animate data-animate-delay="2">
                Over 4+ years, I shipped web products in React, Next.js, and Svelte with Node.js and
                Express APIs on AWS. I led full-stack features, improved speed and accessibility,
                and worked with DevOps on deployment workflows.
            </p>
            <p class="about-bg__para" data-animate data-animate-delay="3">
                I look for roles where technical choices change business results. Faster pages raise
                conversion. Cleaner architecture helps teams ship faster.
            </p>
        </div>

        <dl class="about-bg__stats">
            <div class="about-bg__stat" data-animate data-animate-delay="1">
                <dt class="about-bg__stat-value">{YEARS_OF_PROFESSIONAL_EXPERIENCE}+</dt>
                <dd class="about-bg__stat-label">Years in production</dd>
            </div>
            <div class="about-bg__stat" data-animate data-animate-delay="2">
                <dt class="about-bg__stat-value">5+</dt>
                <dd class="about-bg__stat-label">Systems shipped</dd>
            </div>
            <div class="about-bg__stat" data-animate data-animate-delay="3">
                <dt class="about-bg__stat-value">3</dt>
                <dd class="about-bg__stat-label">Core domains</dd>
            </div>
        </dl>
    </div>
</section>

<style>
    @import "../../styles/mixins.css";

    .about-bg {
        position: relative;
        z-index: 1;
        padding-block: 4rem;
    }

    .about-bg__inner {
        position: relative;
    }

    /* ── Header ── */
    .about-bg__header {
        margin-bottom: 2.5rem;
    }

    .about-bg__label {
        margin-bottom: 0.75rem;
    }

    .about-bg__heading {
        font-size: clamp(1.75rem, 6vw, 2.5rem);
        font-weight: 760;
        letter-spacing: -0.04em;
        color: var(--color-text-primary);
        line-height: 1.1;
        text-wrap: balance;
    }

    /* ── Prose ── */
    .about-bg__prose {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-bottom: 3.5rem;
    }

    @mixin desktop-up {
        .about-bg__prose {
            max-width: 68ch;
        }
    }

    .about-bg__para {
        font-size: clamp(0.95rem, 2.5vw, 1.05rem);
        color: var(--color-text-secondary);
        line-height: 1.75;
        padding: 0.9rem 1rem;
        border: 1px solid rgba(120, 196, 247, 0.14);
        border-radius: 0.7rem;
        background: rgba(16, 26, 38, 0.42);
    }

    /* ── Stats ── */
    .about-bg__stats {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-top: 2.5rem;
        border-top: 1px solid var(--color-border);
    }

    @mixin tablet-up {
        .about-bg__stats {
            flex-direction: row;
            gap: 0;
        }

        .about-bg__stat {
            flex: 1;
            padding-inline: 2rem;
        }

        .about-bg__stat:first-child {
            padding-left: 0;
        }

        .about-bg__stat:not(:last-child) {
            border-right: 1px solid var(--color-border);
        }
    }

    .about-bg__stat-value {
        font-size: clamp(2rem, 6vw, 2.75rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        color: var(--color-accent);
        line-height: 1;
        margin-bottom: 0.4rem;
    }

    .about-bg__stat-label {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
        line-height: 1.4;
    }
</style>

<script>
    import { initScrollReveal } from "@/utils/animations";
    initScrollReveal();
</script>
