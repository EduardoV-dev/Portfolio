---
import { YEARS_OF_PROFESSIONAL_EXPERIENCE } from "@/constants/common";
---

<section class="about-hero" aria-labelledby="about-hero-heading">
    <div class="about-hero__inner layout-container">
        <p class="about-hero__label section-kicker">About</p>
        <h1 class="about-hero__title" id="about-hero-heading">About Me</h1>
        <p class="about-hero__subtext">
            {YEARS_OF_PROFESSIONAL_EXPERIENCE}+ years building products from UI to cloud
            infrastructure. I work across engineering, product, and marketing when delivery needs
            one shared plan.
        </p>
    </div>
</section>

<style>
    @import "../../styles/mixins.css";

    .about-hero {
        position: relative;
        z-index: 1;
        padding-block: 5rem 4rem;
    }

    .about-hero__inner {
        position: relative;
    }

    .about-hero__label {
        margin-bottom: 1rem;
        animation: about-fade-up 500ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: 40ms;
    }

    .about-hero__title {
        font-size: clamp(2.25rem, 8vw, 4rem);
        font-weight: 800;
        letter-spacing: -0.05em;
        color: var(--color-text-primary);
        line-height: 1.05;
        margin-bottom: 1.5rem;
        animation: about-fade-up 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: 120ms;
    }

    .about-hero__subtext {
        font-size: clamp(1rem, 2.5vw, 1.15rem);
        color: var(--color-text-secondary);
        line-height: 1.65;
        max-width: 46ch;
        animation: about-fade-up 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: 200ms;
    }

    @mixin desktop-up {
        .about-hero {
            padding-block: 6rem 4.5rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .about-hero__label,
        .about-hero__title,
        .about-hero__subtext {
            animation: none;
        }
    }

    @keyframes about-fade-up {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
