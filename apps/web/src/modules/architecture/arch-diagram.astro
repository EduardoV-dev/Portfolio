<section class="arch-diagram" aria-labelledby="arch-diagram-heading">
    <div class="arch-diagram__inner">
        <header class="arch-diagram__header">
            <p class="arch-diagram__label" data-animate data-animate-delay="1">SYSTEM DESIGN</p>
            <h2
                class="arch-diagram__heading"
                id="arch-diagram-heading"
                data-animate
                data-animate-delay="2"
            >
                Example System Design
            </h2>
            <p class="arch-diagram__subtext" data-animate data-animate-delay="3">
                A reference architecture showing a production-grade request path — from client to
                data layer.
            </p>
        </header>

        <div class="arch-diagram__canvas" aria-hidden="true" data-animate data-animate-delay="4">
            <div class="arch-diagram__glow"></div>

            <!-- Row 0: Client -->
            <div class="arch-diagram__row arch-diagram__row--0">
                <div class="arch-diagram__node arch-diagram__node--client">
                    <span class="arch-diagram__node-icon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><rect x="2" y="3" width="20" height="14" rx="2"></rect><line
                                x1="8"
                                y1="21"
                                x2="16"
                                y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg
                        >
                    </span>
                    <span class="arch-diagram__node-label">Client</span>
                </div>
            </div>

            <!-- Connector 0→1 -->
            <div class="arch-diagram__connector arch-diagram__connector--0">
                <div class="arch-diagram__connector-line"></div>
                <span class="arch-diagram__connector-tag">HTTPS</span>
            </div>

            <!-- Row 1: API Gateway + Auth -->
            <div class="arch-diagram__row arch-diagram__row--1">
                <div class="arch-diagram__node arch-diagram__node--gateway">
                    <span class="arch-diagram__node-icon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path
                                d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
                            ></path></svg
                        >
                    </span>
                    <span class="arch-diagram__node-label">API Gateway</span>
                </div>
                <div class="arch-diagram__node arch-diagram__node--auth">
                    <span class="arch-diagram__node-icon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path
                                d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
                        >
                    </span>
                    <span class="arch-diagram__node-label">Auth</span>
                </div>
            </div>

            <!-- Connector 1→2 -->
            <div class="arch-diagram__connector arch-diagram__connector--1">
                <div class="arch-diagram__connector-line"></div>
                <span class="arch-diagram__connector-tag">gRPC / REST</span>
            </div>

            <!-- Row 2: Services + Cache -->
            <div class="arch-diagram__row arch-diagram__row--2">
                <div class="arch-diagram__node arch-diagram__node--service">
                    <span class="arch-diagram__node-icon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><polyline points="16 18 22 12 16 6"></polyline><polyline
                                points="8 6 2 12 8 18"></polyline></svg
                        >
                    </span>
                    <span class="arch-diagram__node-label">Service A</span>
                </div>
                <div class="arch-diagram__node arch-diagram__node--service">
                    <span class="arch-diagram__node-icon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><circle cx="12" cy="12" r="3"></circle><path
                                d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"
                            ></path></svg
                        >
                    </span>
                    <span class="arch-diagram__node-label">Service B</span>
                </div>
                <div class="arch-diagram__node arch-diagram__node--cache">
                    <span class="arch-diagram__node-icon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path
                                d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path
                                d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg
                        >
                    </span>
                    <span class="arch-diagram__node-label">Cache</span>
                </div>
            </div>

            <!-- Connector 2→3 -->
            <div class="arch-diagram__connector arch-diagram__connector--2">
                <div class="arch-diagram__connector-line"></div>
                <span class="arch-diagram__connector-tag">TCP / SQL</span>
            </div>

            <!-- Row 3: Data Layer -->
            <div class="arch-diagram__row arch-diagram__row--3">
                <div class="arch-diagram__node arch-diagram__node--db">
                    <span class="arch-diagram__node-icon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path
                                d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path
                                d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg
                        >
                    </span>
                    <span class="arch-diagram__node-label">PostgreSQL</span>
                </div>
                <div class="arch-diagram__node arch-diagram__node--queue">
                    <span class="arch-diagram__node-icon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><line x1="22" y1="12" x2="2" y2="12"></line><path
                                d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"
                            ></path></svg
                        >
                    </span>
                    <span class="arch-diagram__node-label">Queue</span>
                </div>
                <div class="arch-diagram__node arch-diagram__node--analytics">
                    <span class="arch-diagram__node-icon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><line x1="18" y1="20" x2="18" y2="10"></line><line
                                x1="12"
                                y1="20"
                                x2="12"
                                y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg
                        >
                    </span>
                    <span class="arch-diagram__node-label">Analytics</span>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @import "../../styles/mixins.css";

    .arch-diagram {
        position: relative;
        z-index: 1;
        padding-block: 4rem;
    }

    .arch-diagram__inner {
        max-width: 1280px;
        margin: 0 auto;
        padding-inline: 1rem;
    }

    @mixin tablet-up {
        .arch-diagram__inner {
            padding-inline: 1.5rem;
        }
    }

    /* ── Section header ── */
    .arch-diagram__header {
        margin-bottom: 3rem;
    }

    @mixin desktop-up {
        .arch-diagram__header {
            max-width: 52rem;
            margin-bottom: 3.5rem;
        }
    }

    .arch-diagram__label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: 0.75rem;
    }

    .arch-diagram__heading {
        font-size: clamp(1.75rem, 6vw, 2.5rem);
        font-weight: 760;
        letter-spacing: -0.04em;
        color: var(--color-text-primary);
        line-height: 1.1;
        margin-bottom: 1.25rem;
        text-wrap: balance;
    }

    .arch-diagram__subtext {
        font-size: clamp(0.95rem, 2.5vw, 1.05rem);
        color: var(--color-text-secondary);
        line-height: 1.65;
        max-width: 48rem;
    }

    /* ── Canvas ── */
    .arch-diagram__canvas {
        position: relative;
        border: 1px solid var(--color-border);
        border-radius: 1.25rem;
        background:
            repeating-linear-gradient(
                90deg,
                color-mix(in srgb, var(--color-accent) 2.5%, transparent) 0,
                color-mix(in srgb, var(--color-accent) 2.5%, transparent) 1px,
                transparent 1px,
                transparent 60px
            ),
            repeating-linear-gradient(
                0deg,
                color-mix(in srgb, var(--color-accent) 2.5%, transparent) 0,
                color-mix(in srgb, var(--color-accent) 2.5%, transparent) 1px,
                transparent 1px,
                transparent 60px
            ),
            var(--color-surface);
        padding: 2.5rem 1.5rem;
        overflow: hidden;
    }

    @mixin tablet-up {
        .arch-diagram__canvas {
            padding: 3rem 2.5rem;
        }
    }

    .arch-diagram__glow {
        position: absolute;
        top: 30%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 60%;
        height: 50%;
        background: radial-gradient(
            ellipse at center,
            color-mix(in srgb, var(--color-accent) 9%, transparent) 0%,
            color-mix(in srgb, var(--color-accent) 3%, transparent) 50%,
            transparent 70%
        );
        pointer-events: none;
        filter: blur(24px);
    }

    /* ── Rows ── */
    .arch-diagram__row {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: center;
        gap: 0.75rem;
    }

    @mixin tablet-up {
        .arch-diagram__row {
            gap: 1.25rem;
        }
    }

    /* Row staggered fade-in */
    .arch-diagram__row--0 {
        animation: row-in 480ms cubic-bezier(0.22, 1, 0.36, 1) both 200ms;
    }
    .arch-diagram__row--1 {
        animation: row-in 480ms cubic-bezier(0.22, 1, 0.36, 1) both 380ms;
    }
    .arch-diagram__row--2 {
        animation: row-in 480ms cubic-bezier(0.22, 1, 0.36, 1) both 540ms;
    }
    .arch-diagram__row--3 {
        animation: row-in 480ms cubic-bezier(0.22, 1, 0.36, 1) both 700ms;
    }

    @keyframes row-in {
        from {
            opacity: 0;
            transform: translateY(14px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Connectors ── */
    .arch-diagram__connector {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        padding-block: 0.1rem;
    }

    .arch-diagram__connector-line {
        width: 1px;
        height: 2rem;
        background: linear-gradient(
            to bottom,
            color-mix(in srgb, var(--color-accent) 35%, transparent),
            color-mix(in srgb, var(--color-accent) 15%, transparent)
        );
        position: relative;
    }

    .arch-diagram__connector-line::after {
        content: "";
        position: absolute;
        bottom: -4px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 4px solid transparent;
        border-right: 4px solid transparent;
        border-top: 5px solid color-mix(in srgb, var(--color-accent) 50%, transparent);
    }

    .arch-diagram__connector-tag {
        font-size: 0.6rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-accent);
        opacity: 0.55;
        margin-top: 0.35rem;
    }

    /* Connectors fade in after rows */
    .arch-diagram__connector--0 {
        animation: row-in 380ms cubic-bezier(0.22, 1, 0.36, 1) both 300ms;
    }
    .arch-diagram__connector--1 {
        animation: row-in 380ms cubic-bezier(0.22, 1, 0.36, 1) both 460ms;
    }
    .arch-diagram__connector--2 {
        animation: row-in 380ms cubic-bezier(0.22, 1, 0.36, 1) both 620ms;
    }

    /* ── Nodes ── */
    .arch-diagram__node {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 0.85rem 0.75rem;
        min-width: 5rem;
        background: var(--color-bg-elevated);
        border: 1px solid var(--color-border);
        border-radius: 0.75rem;
        cursor: default;
        touch-action: manipulation;
        transition:
            border-color var(--transition-fast),
            box-shadow var(--transition-fast),
            transform var(--transition-fast);
    }

    @mixin tablet-up {
        .arch-diagram__node {
            padding: 1rem 1.25rem;
            min-width: 7rem;
            border-radius: 0.85rem;
        }
    }

    .arch-diagram__node:hover {
        border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
        box-shadow: 0 0 20px color-mix(in srgb, var(--color-accent) 12%, transparent);
        transform: translateY(-2px);
    }

    /* Accent treatment for key nodes */
    .arch-diagram__node--gateway,
    .arch-diagram__node--client {
        border-color: color-mix(in srgb, var(--color-accent) 22%, transparent);
        background: linear-gradient(
            160deg,
            color-mix(in srgb, var(--color-accent) 6%, transparent) 0%,
            var(--color-bg-elevated) 60%
        );
    }

    .arch-diagram__node--gateway:hover,
    .arch-diagram__node--client:hover {
        border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
        box-shadow: 0 0 24px color-mix(in srgb, var(--color-accent) 18%, transparent);
    }

    .arch-diagram__node-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-accent);
        opacity: 0.8;
    }

    .arch-diagram__node-icon svg {
        width: 1.1rem;
        height: 1.1rem;
    }

    @mixin tablet-up {
        .arch-diagram__node-icon svg {
            width: 1.25rem;
            height: 1.25rem;
        }
    }

    .arch-diagram__node--client .arch-diagram__node-icon,
    .arch-diagram__node--gateway .arch-diagram__node-icon {
        opacity: 1;
    }

    .arch-diagram__node-label {
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--color-text-secondary);
        text-align: center;
        white-space: nowrap;
    }

    @mixin tablet-up {
        .arch-diagram__node-label {
            font-size: 0.75rem;
        }
    }

    .arch-diagram__node--client .arch-diagram__node-label,
    .arch-diagram__node--gateway .arch-diagram__node-label {
        color: var(--color-text-primary);
    }

    @media (prefers-reduced-motion: reduce) {
        .arch-diagram__row,
        .arch-diagram__connector {
            animation: none;
        }

        .arch-diagram__row--0,
        .arch-diagram__row--1,
        .arch-diagram__row--2,
        .arch-diagram__row--3,
        .arch-diagram__connector--0,
        .arch-diagram__connector--1,
        .arch-diagram__connector--2 {
            animation: none;
        }

        .arch-diagram__node {
            transition: none;
        }
    }
</style>

<script>
    import { initScrollReveal } from "@/utils/animations";
    initScrollReveal();
</script>
