---
import ArchPrinciplesCard from "./arch-principles-card.astro";

const principles = [
    {
        iconName: "scalability" as const,
        title: "Scalability First",
        description:
            "I design systems to scale with traffic and data growth without major rewrites.",
    },
    {
        iconName: "resilience" as const,
        title: "Resilience & Reliability",
        description:
            "I design failure handling with redundancy, circuit breakers, and graceful degradation.",
    },
    {
        iconName: "performance" as const,
        title: "Performance-Oriented",
        description:
            "I tune query paths, cache behavior, payload size, and infrastructure for predictable load performance.",
    },
    {
        iconName: "maintainability" as const,
        title: "Maintainability",
        description:
            "I enforce module boundaries and service contracts so teams can evolve systems without design debt.",
    },
];
---

<section class="arch-principles" aria-labelledby="arch-principles-heading">
    <div class="arch-principles__inner layout-container">
        <header class="arch-principles__header">
            <p class="arch-principles__label section-kicker" data-animate data-animate-delay="1">
                Core principles
            </p>
            <h2
                class="arch-principles__heading"
                id="arch-principles-heading"
                data-animate
                data-animate-delay="2"
            >
                System Design Approach
            </h2>
            <p class="arch-principles__subtext" data-animate data-animate-delay="3">
                I keep tradeoffs explicit so teams can make faster calls under production pressure.
            </p>
        </header>

        <ul class="arch-principles__grid" role="list">
            {principles.map((p, i) => <ArchPrinciplesCard {...p} delay={i + 1} />)}
        </ul>
    </div>
</section>

<style>
    @import "../../styles/mixins.css";

    .arch-principles {
        position: relative;
        z-index: 1;
        padding-block: 4rem;
    }

    .arch-principles__inner {
        position: relative;
    }

    /* ── Header ── */
    .arch-principles__header {
        margin-bottom: 3rem;
    }

    @mixin desktop-up {
        .arch-principles__header {
            max-width: 52rem;
            margin-bottom: 3.5rem;
        }
    }

    .arch-principles__label {
        margin-bottom: 0.75rem;
    }

    .arch-principles__heading {
        font-size: clamp(1.75rem, 6vw, 2.5rem);
        font-weight: 760;
        letter-spacing: -0.04em;
        color: var(--color-text-primary);
        line-height: 1.1;
        margin-bottom: 1.25rem;
        text-wrap: balance;
    }

    .arch-principles__subtext {
        font-size: clamp(0.95rem, 2.5vw, 1.05rem);
        color: var(--color-text-secondary);
        line-height: 1.65;
        max-width: 48rem;
    }

    /* ── Grid ── */
    .arch-principles__grid {
        list-style: none;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    @mixin tablet-up {
        .arch-principles__grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.25rem;
        }
    }

    @mixin desktop-up {
        .arch-principles__grid {
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
        }
    }
</style>

<script>
    import { initScrollReveal } from "@/utils/animations";
    initScrollReveal();
</script>
