---
import { APP_ROUTES } from "@/constants/routes";
---

<section class="idc" aria-labelledby="idc-heading">
    <div class="idc__inner" data-animate>
        <p class="idc__eyebrow">ENJOYED THIS?</p>
        <h2 class="idc__heading" id="idc-heading">
            Let's talk about how to apply it to your project.
        </h2>
        <a href={`${APP_ROUTES.CONTACT}#book-a-call`} class="idc__btn">Start a Conversation</a>
    </div>
</section>

<style>
    @import "../../styles/mixins.css";

    .idc {
        position: relative;
        z-index: 1;
        padding-block: 1rem 6rem;
    }

    .idc__inner {
        max-width: 1280px;
        margin: 0 auto;
        padding-inline: 1rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 14px;
        padding: 2.5rem 1.75rem;
    }

    .idc__eyebrow {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent);
    }

    .idc__heading {
        font-size: clamp(1.3rem, 4vw, 1.85rem);
        font-weight: 760;
        letter-spacing: -0.035em;
        color: var(--color-text-primary);
        line-height: 1.2;
        text-wrap: balance;
        max-width: 36ch;
    }

    .idc__btn {
        display: inline-flex;
        align-items: center;
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--color-cta-text);
        background: linear-gradient(
            135deg,
            var(--color-accent-hover),
            var(--color-accent),
            var(--color-accent-hover)
        );
        border-radius: 8px;
        padding: 0.7rem 1.5rem;
        text-decoration: none;
        touch-action: manipulation;
        transition:
            background var(--transition-fast),
            transform var(--transition-fast),
            box-shadow var(--transition-fast);
    }

    .idc__btn:hover {
        background: linear-gradient(135deg, #5ec0ff, #7dd3fc, #5dc0ff);
        transform: translateY(-1px);
        box-shadow: 0 6px 20px color-mix(in srgb, var(--color-accent) 30%, transparent);
    }

    .idc__btn:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
        border-radius: 8px;
    }

    @mixin tablet-up {
        .idc__inner {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            padding: 2.75rem 2.5rem;
        }
    }

    @mixin desktop-up {
        .idc__inner {
            padding: 3rem 3.5rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .idc__btn {
            transition: none;
        }
    }
</style>

<script>
    import { initScrollReveal } from "@/utils/animations";
    initScrollReveal();
</script>
