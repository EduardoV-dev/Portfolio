---
import { APP_ROUTES } from "@/constants/routes";
---

<section class="csd-cta" data-animate aria-label="Call to action">
    <h2 class="csd-cta__heading">Interested in building something similar?</h2>
    <p class="csd-cta__sub">Let's design a scalable solution tailored to your needs.</p>
    <a href={APP_ROUTES.CONTACT} class="csd-cta__btn"> Schedule a Call </a>
</section>

<style>
    @import "../../../styles/mixins.css";

    .csd-cta {
        padding-block: 4rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.25rem;
        scroll-margin-top: calc(var(--header-height, 68px) + 1.5rem);
    }

    .csd-cta__heading {
        font-size: clamp(1.6rem, 5vw, 2.4rem);
        font-weight: 760;
        letter-spacing: -0.04em;
        line-height: 1.1;
        color: var(--color-text-primary);
        max-width: 20ch;
        text-wrap: balance;
    }

    .csd-cta__sub {
        font-size: clamp(0.9rem, 2vw, 1rem);
        color: var(--color-text-secondary);
        line-height: 1.65;
        max-width: 42ch;
    }

    .csd-cta__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 0.5rem;
        padding: 0.9rem 1.85rem;
        min-height: 3.5rem;
        border-radius: 0.85rem;
        border: 1px solid transparent;
        color: #04131f;
        background: linear-gradient(
            135deg,
            var(--color-accent-hover) 0%,
            var(--color-accent) 52%,
            var(--color-accent-hover) 100%
        );
        box-shadow:
            0 10px 28px color-mix(in srgb, var(--color-accent) 22%, transparent),
            inset 0 -1px 0 rgba(255, 255, 255, 0.25);
        font-size: 0.98rem;
        font-weight: 650;
        letter-spacing: -0.01em;
        text-decoration: none;
        touch-action: manipulation;
        transition:
            transform var(--transition-fast),
            box-shadow var(--transition-base);
    }

    .csd-cta__btn:hover {
        transform: translateY(-2px);
        box-shadow:
            0 14px 32px color-mix(in srgb, var(--color-accent) 32%, transparent),
            inset 0 -1px 0 rgba(255, 255, 255, 0.3);
    }

    .csd-cta__btn:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
    }

    .csd-cta__btn:active {
        transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
        .csd-cta__btn {
            transition: none;
        }
        .csd-cta__btn:hover {
            transform: none;
        }
    }
</style>
