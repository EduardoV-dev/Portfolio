---
import type { ProjectDetail } from "@/types/strapi";

export interface Props {
    highlights: ProjectDetail["highlights"];
}

const { highlights } = Astro.props;
---

<section class="csd-section" id="highlights" data-animate aria-labelledby="highlights-heading">
    <p class="csd-section__label">05</p>
    <h2 class="csd-section__heading" id="highlights-heading">Implementation Highlights</h2>

    <div class="csd-highlights">
        {
            highlights.map((h) => (
                <div class="csd-highlight">
                    <h3 class="csd-highlight__title">{h.title}</h3>
                    <p class="csd-highlight__desc">{h.description}</p>
                    {h.code && (
                        <div class="csd-code-block" data-language={h.code.language}>
                            <div class="csd-code-block__header">
                                <span class="csd-code-block__lang">{h.code.language}</span>
                                <button
                                    class="csd-code-block__copy"
                                    data-code={h.code.snippet}
                                    aria-label="Copy code snippet"
                                >
                                    <svg
                                        class="csd-code-block__copy-icon csd-code-block__copy-icon--default"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="13"
                                        height="13"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                    >
                                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                    </svg>
                                    <svg
                                        class="csd-code-block__copy-icon csd-code-block__copy-icon--success"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="13"
                                        height="13"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                        style="display:none"
                                    >
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    <span class="csd-code-block__copy-label">Copy</span>
                                </button>
                            </div>
                            <pre class="csd-code-block__pre">
                                <code class="csd-code-block__code">{h.code.snippet}</code>
                            </pre>
                        </div>
                    )}
                </div>
            ))
        }
    </div>
</section>

<style>
    @import "../../../styles/mixins.css";

    .csd-section {
        padding-block: 3rem;
        border-bottom: 1px solid var(--color-border);
        scroll-margin-top: calc(var(--header-height, 68px) + 1.5rem);
    }

    .csd-section__label {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: 0.6rem;
        opacity: 0.7;
    }

    .csd-section__heading {
        font-size: clamp(1.35rem, 3.5vw, 1.75rem);
        font-weight: 740;
        letter-spacing: -0.035em;
        line-height: 1.15;
        color: var(--color-text-primary);
        margin-bottom: 1.5rem;
    }

    .csd-highlights {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .csd-highlight {
        border-left: 2px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
        padding-left: 1.5rem;
    }

    .csd-highlight__title {
        font-size: 1rem;
        font-weight: 680;
        color: var(--color-text-primary);
        letter-spacing: -0.02em;
        margin-bottom: 0.6rem;
    }

    .csd-highlight__desc {
        font-size: 0.88rem;
        color: var(--color-text-secondary);
        line-height: 1.7;
        margin-bottom: 1rem;
        max-width: 68ch;
    }

    /* Code block */
    .csd-code-block {
        border-radius: 0.65rem;
        overflow: hidden;
        border: 1px solid var(--color-border);
        background: #070d18;
    }

    .csd-code-block__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.55rem 1rem;
        border-bottom: 1px solid var(--color-border);
        background: color-mix(in srgb, var(--color-accent) 4%, transparent);
    }

    .csd-code-block__lang {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-accent);
        opacity: 0.75;
    }

    .csd-code-block__copy {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: transparent;
        border: none;
        cursor: pointer;
        color: var(--color-text-secondary);
        font-size: 0.7rem;
        font-weight: 600;
        font-family: var(--font-sans);
        letter-spacing: 0.04em;
        padding: 0.2rem 0.4rem;
        border-radius: 0.3rem;
        transition: color var(--transition-fast);
    }

    .csd-code-block__copy:hover {
        color: var(--color-text-primary);
    }

    .csd-code-block__copy:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
    }

    .csd-code-block__pre {
        margin: 0;
        padding: 1.25rem 1.25rem;
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--color-accent) 20%, transparent) transparent;
    }

    .csd-code-block__code {
        font-family: "Fira Code", "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
        font-size: 0.8rem;
        line-height: 1.7;
        color: #c8d3e8;
        white-space: pre;
        display: block;
    }
</style>

<script>
    document.querySelectorAll<HTMLButtonElement>(".csd-code-block__copy").forEach((btn) => {
        btn.addEventListener("click", async () => {
            const code = btn.dataset.code ?? "";
            const iconDefault = btn.querySelector<SVGElement>(
                ".csd-code-block__copy-icon--default",
            )!;
            const iconSuccess = btn.querySelector<SVGElement>(
                ".csd-code-block__copy-icon--success",
            )!;
            const label = btn.querySelector<HTMLSpanElement>(".csd-code-block__copy-label")!;

            try {
                await navigator.clipboard.writeText(code);
            } catch {
                // Fallback for non-secure contexts
                const ta = document.createElement("textarea");
                ta.value = code;
                ta.style.position = "fixed";
                ta.style.opacity = "0";
                document.body.appendChild(ta);
                ta.select();
                document.execCommand("copy");
                document.body.removeChild(ta);
            }

            iconDefault.style.display = "none";
            iconSuccess.style.display = "";
            label.textContent = "Copied!";

            setTimeout(() => {
                iconDefault.style.display = "";
                iconSuccess.style.display = "none";
                label.textContent = "Copy";
            }, 2000);
        });
    });
</script>
