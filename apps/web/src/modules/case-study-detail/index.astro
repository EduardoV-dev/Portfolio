---
import CaseStudyNav from "@/components/case-study-nav/index.astro";
import type { Project } from "@/types/strapi";
import { APP_ROUTES } from "@/constants/routes";
import Hero from "./hero/index.astro";
import ProseSection from "./prose-section/index.astro";
import Highlights from "./highlights/index.astro";
import Impact from "./impact/index.astro";
import TechStack from "./tech-stack/index.astro";
import Learnings from "./learnings/index.astro";
import Cta from "./cta/index.astro";

export interface Props {
    project: Project;
}

const navItems = [
    { id: "overview", label: "Overview" },
    { id: "challenge", label: "The Challenge" },
    { id: "solution", label: "Solution" },
    { id: "highlights", label: "Highlights" },
    { id: "impact", label: "Impact" },
    { id: "tech-stack", label: "Tech Stack" },
    { id: "learnings", label: "Key Learnings" },
];

const { project } = Astro.props;
const { detail } = project;
---

<div class="csd-page">
    <div class="csd-page__inner">
        <!-- ─── STICKY SIDE NAV ─── -->
        <CaseStudyNav items={navItems} backHref={APP_ROUTES.CASE_STUDIES.ROOT} />

        <!-- ─── MAIN CONTENT ─── -->
        <div class="csd-content">
            <Hero project={project} />

            <hr class="csd-divider" />

            <ProseSection id="overview" number="01" heading="Overview" body={detail.overview} />
            <ProseSection
                id="challenge"
                number="02"
                heading="The Challenge"
                body={detail.challenge}
            />
            <ProseSection id="solution" number="03" heading="Solution" body={detail.solution} />

            <Highlights highlights={detail.highlights} />
            <Impact impactDetails={detail.impactDetails} />
            <TechStack skills={detail.skills} />
            <Learnings learnings={detail.learnings} />

            <Cta />
        </div>
    </div>
</div>

<style>
    @import "../../styles/mixins.css";

    .csd-page {
        position: relative;
        z-index: 1;
        padding-block: 3rem 4rem;
    }

    .csd-page__inner {
        max-width: 1280px;
        margin: 0 auto;
        padding-inline: 1rem;
        display: flex;
        gap: 0;
        align-items: flex-start;
    }

    @mixin tablet-up {
        .csd-page__inner {
            padding-inline: 1.5rem;
        }
    }

    @mixin desktop-up {
        .csd-page__inner {
            gap: 4rem;
        }
    }

    .csd-content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .csd-divider {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 0;
    }
</style>

<script>
    import { initScrollReveal } from "@/utils/animations";
    initScrollReveal();
</script>
