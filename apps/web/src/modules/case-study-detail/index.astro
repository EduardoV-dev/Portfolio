---
import CaseStudyNav from "@/components/case-study-nav/index.astro";
import type { Project } from "@/data/projects";

export interface Props {
    project: Project;
}

const { project } = Astro.props;
const { detail } = project;

const navItems = [
    { id: "overview", label: "Overview" },
    { id: "challenge", label: "The Challenge" },
    { id: "solution", label: "Solution" },
    { id: "architecture", label: "Architecture" },
    { id: "highlights", label: "Highlights" },
    { id: "impact", label: "Impact" },
    { id: "tech-stack", label: "Tech Stack" },
    { id: "learnings", label: "Key Learnings" },
];
---

<div class="csd-page">
    <div class="csd-page__inner">
        <!-- ─── STICKY SIDE NAV ─── -->
        <CaseStudyNav items={navItems} backHref="/case-studies" />

        <!-- ─── MAIN CONTENT ─── -->
        <main class="csd-content" id="main-content">
            <!-- ══════════════════════════════
                 1. HERO
            ══════════════════════════════ -->
            <section class="csd-hero" aria-label="Project overview">
                <a href="/case-studies" class="csd-hero__back" aria-label="Back to case studies">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M19 12H5M12 5l-7 7 7 7"></path>
                    </svg>
                    All Case Studies
                </a>

                <div class="csd-hero__tags">
                    {project.tags.map((tag) => <span class="csd-tag">{tag}</span>)}
                </div>

                <h1 class="csd-hero__title" data-animate>{project.title}</h1>
                <p class="csd-hero__impact" data-animate data-animate-delay="1">{project.impact}</p>
                <p class="csd-hero__desc" data-animate data-animate-delay="2">
                    {project.description}
                </p>

                <!-- Key metrics -->
                <div class="csd-hero__metrics" data-animate data-animate-delay="3">
                    {
                        detail.metrics.map((m) => (
                            <div class="csd-metric">
                                <span class="csd-metric__value">{m.value}</span>
                                <span class="csd-metric__label">{m.label}</span>
                            </div>
                        ))
                    }
                </div>

                <!-- Action links -->
                <div class="csd-hero__actions" data-animate data-animate-delay="4">
                    <a href={project.sourceHref} class="csd-hero__action-link">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <polyline points="16 18 22 12 16 6"></polyline>
                            <polyline points="8 6 2 12 8 18"></polyline>
                        </svg>
                        Source Code
                    </a>
                    <a href={project.liveHref} class="csd-hero__action-link">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                            ></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                        Live Project
                    </a>
                </div>
            </section>

            <!-- Divider -->
            <hr class="csd-divider" />

            <!-- ══════════════════════════════
                 2. OVERVIEW
            ══════════════════════════════ -->
            <section
                class="csd-section"
                id="overview"
                data-animate
                aria-labelledby="overview-heading"
            >
                <p class="csd-section__label">01</p>
                <h2 class="csd-section__heading" id="overview-heading">Overview</h2>
                <p class="csd-prose">{detail.overview}</p>
            </section>

            <!-- ══════════════════════════════
                 3. CHALLENGE
            ══════════════════════════════ -->
            <section
                class="csd-section"
                id="challenge"
                data-animate
                aria-labelledby="challenge-heading"
            >
                <p class="csd-section__label">02</p>
                <h2 class="csd-section__heading" id="challenge-heading">The Challenge</h2>
                <p class="csd-prose">{detail.challenge}</p>
            </section>

            <!-- ══════════════════════════════
                 4. SOLUTION
            ══════════════════════════════ -->
            <section
                class="csd-section"
                id="solution"
                data-animate
                aria-labelledby="solution-heading"
            >
                <p class="csd-section__label">03</p>
                <h2 class="csd-section__heading" id="solution-heading">Solution</h2>
                <p class="csd-prose">{detail.solution}</p>
            </section>

            <!-- ══════════════════════════════
                 5. ARCHITECTURE
            ══════════════════════════════ -->
            <section
                class="csd-section"
                id="architecture"
                data-animate
                aria-labelledby="arch-heading"
            >
                <p class="csd-section__label">04</p>
                <h2 class="csd-section__heading" id="arch-heading">System Architecture</h2>
                <p class="csd-prose csd-prose--mb">{detail.architecture.description}</p>

                <div class="csd-arch-layers">
                    {
                        detail.architecture.layers.map((layer) => (
                            <div class="csd-arch-layer">
                                <div class="csd-arch-layer__header">
                                    <span class="csd-arch-layer__name">{layer.name}</span>
                                </div>
                                <div class="csd-arch-layer__chips">
                                    {layer.components.map((c) => (
                                        <span class="csd-arch-chip">{c}</span>
                                    ))}
                                </div>
                                <p class="csd-arch-layer__desc">{layer.description}</p>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- ══════════════════════════════
                 6. HIGHLIGHTS
            ══════════════════════════════ -->
            <section
                class="csd-section"
                id="highlights"
                data-animate
                aria-labelledby="highlights-heading"
            >
                <p class="csd-section__label">05</p>
                <h2 class="csd-section__heading" id="highlights-heading">
                    Implementation Highlights
                </h2>

                <div class="csd-highlights">
                    {
                        detail.highlights.map((h) => (
                            <div class="csd-highlight">
                                <h3 class="csd-highlight__title">{h.title}</h3>
                                <p class="csd-highlight__desc">{h.description}</p>
                                {h.code && (
                                    <div class="csd-code-block" data-language={h.code.language}>
                                        <div class="csd-code-block__header">
                                            <span class="csd-code-block__lang">
                                                {h.code.language}
                                            </span>
                                            <button
                                                class="csd-code-block__copy"
                                                data-code={h.code.snippet}
                                                aria-label="Copy code snippet"
                                            >
                                                <svg
                                                    class="csd-code-block__copy-icon csd-code-block__copy-icon--default"
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="13"
                                                    height="13"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    aria-hidden="true"
                                                >
                                                    <rect
                                                        x="9"
                                                        y="9"
                                                        width="13"
                                                        height="13"
                                                        rx="2"
                                                        ry="2"
                                                    />
                                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                                </svg>
                                                <svg
                                                    class="csd-code-block__copy-icon csd-code-block__copy-icon--success"
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="13"
                                                    height="13"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2.5"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    aria-hidden="true"
                                                    style="display:none"
                                                >
                                                    <polyline points="20 6 9 17 4 12" />
                                                </svg>
                                                <span class="csd-code-block__copy-label">Copy</span>
                                            </button>
                                        </div>
                                        <pre class="csd-code-block__pre">
                                            <code class="csd-code-block__code">
                                                {h.code.snippet}
                                            </code>
                                        </pre>
                                    </div>
                                )}
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- ══════════════════════════════
                 7. IMPACT
            ══════════════════════════════ -->
            <section class="csd-section" id="impact" data-animate aria-labelledby="impact-heading">
                <p class="csd-section__label">06</p>
                <h2 class="csd-section__heading" id="impact-heading">Impact</h2>

                <ul class="csd-impact-list" role="list">
                    {
                        detail.impactDetails.map((item) => (
                            <li class="csd-impact-item">
                                <svg
                                    class="csd-impact-item__icon"
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="15"
                                    height="15"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                    <polyline points="22 4 12 14.01 9 11.01" />
                                </svg>
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </section>

            <!-- ══════════════════════════════
                 8. TECH STACK
            ══════════════════════════════ -->
            <section
                class="csd-section"
                id="tech-stack"
                data-animate
                aria-labelledby="tech-heading"
            >
                <p class="csd-section__label">07</p>
                <h2 class="csd-section__heading" id="tech-heading">Tech Stack</h2>

                <div class="csd-techstack">
                    {
                        detail.techStack.frontend && (
                            <div class="csd-techstack__group">
                                <p class="csd-techstack__group-label">Frontend</p>
                                <div class="csd-techstack__chips">
                                    {detail.techStack.frontend.map((t) => (
                                        <span class="csd-tech-chip">{t}</span>
                                    ))}
                                </div>
                            </div>
                        )
                    }
                    {
                        detail.techStack.backend && (
                            <div class="csd-techstack__group">
                                <p class="csd-techstack__group-label">Backend</p>
                                <div class="csd-techstack__chips">
                                    {detail.techStack.backend.map((t) => (
                                        <span class="csd-tech-chip">{t}</span>
                                    ))}
                                </div>
                            </div>
                        )
                    }
                    {
                        detail.techStack.infrastructure && (
                            <div class="csd-techstack__group">
                                <p class="csd-techstack__group-label">Infrastructure</p>
                                <div class="csd-techstack__chips">
                                    {detail.techStack.infrastructure.map((t) => (
                                        <span class="csd-tech-chip">{t}</span>
                                    ))}
                                </div>
                            </div>
                        )
                    }
                    {
                        detail.techStack.tools && (
                            <div class="csd-techstack__group">
                                <p class="csd-techstack__group-label">Tools</p>
                                <div class="csd-techstack__chips">
                                    {detail.techStack.tools.map((t) => (
                                        <span class="csd-tech-chip">{t}</span>
                                    ))}
                                </div>
                            </div>
                        )
                    }
                </div>
            </section>

            <!-- ══════════════════════════════
                 9. LEARNINGS
            ══════════════════════════════ -->
            <section
                class="csd-section"
                id="learnings"
                data-animate
                aria-labelledby="learnings-heading"
            >
                <p class="csd-section__label">08</p>
                <h2 class="csd-section__heading" id="learnings-heading">Key Learnings</h2>

                <div class="csd-learnings">
                    {
                        detail.learnings.map((l, i) => (
                            <div class="csd-learning">
                                <span class="csd-learning__num" aria-hidden="true">
                                    {String(i + 1).padStart(2, "0")}
                                </span>
                                <p class="csd-learning__text">{l}</p>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- ══════════════════════════════
                 10. CTA
            ══════════════════════════════ -->
            <section class="csd-cta" data-animate aria-label="Call to action">
                <h2 class="csd-cta__heading">Interested in building something similar?</h2>
                <p class="csd-cta__sub">Let's design a scalable solution tailored to your needs.</p>
                <a href="/contact" class="csd-cta__btn"> Schedule a Call </a>
            </section>
        </main>
    </div>
</div>

<style>
    @import "../../styles/mixins.css";

    /* ─────────────────────────────
       Page wrapper
    ───────────────────────────── */
    .csd-page {
        position: relative;
        z-index: 1;
        padding-block: 3rem 4rem;
    }

    .csd-page__inner {
        max-width: 1280px;
        margin: 0 auto;
        padding-inline: 1rem;
        display: flex;
        gap: 0;
        align-items: flex-start;
    }

    @mixin tablet-up {
        .csd-page__inner {
            padding-inline: 1.5rem;
        }
    }

    @mixin desktop-up {
        .csd-page__inner {
            gap: 4rem;
        }
    }

    /* ─────────────────────────────
       Content column
    ───────────────────────────── */
    .csd-content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    /* ─────────────────────────────
       HERO
    ───────────────────────────── */
    .csd-hero {
        padding-bottom: 3rem;
    }

    .csd-hero__back {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
        text-decoration: none;
        margin-bottom: 1.75rem;
        transition: color var(--transition-fast);
    }

    .csd-hero__back:hover {
        color: var(--color-text-primary);
    }

    /* Hide back link on desktop — nav handles it */
    @mixin desktop-up {
        .csd-hero__back {
            display: none;
        }
    }

    .csd-hero__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
    }

    .csd-tag {
        display: inline-block;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.2rem 0.55rem;
        border-radius: 0.3rem;
        border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
        background: color-mix(in srgb, var(--color-accent) 8%, transparent);
        color: var(--color-accent);
    }

    .csd-hero__title {
        font-size: clamp(2rem, 6vw, 3.25rem);
        font-weight: 780;
        letter-spacing: -0.04em;
        line-height: 1.05;
        color: var(--color-text-primary);
        margin-bottom: 0.85rem;
        text-wrap: balance;
    }

    .csd-hero__impact {
        font-size: clamp(0.95rem, 2vw, 1.05rem);
        font-weight: 500;
        color: var(--color-accent);
        line-height: 1.55;
        margin-bottom: 0.65rem;
    }

    .csd-hero__desc {
        font-size: 0.95rem;
        color: var(--color-text-secondary);
        line-height: 1.7;
        max-width: 60ch;
        margin-bottom: 2rem;
    }

    /* Metrics bar */
    .csd-hero__metrics {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background: var(--color-border);
        border: 1px solid var(--color-border);
        border-radius: 0.75rem;
        overflow: hidden;
        margin-bottom: 1.75rem;
    }

    @mixin tablet-up {
        .csd-hero__metrics {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .csd-metric {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        padding: 1.25rem 1.5rem;
        background: var(--color-surface);
    }

    .csd-metric__value {
        font-size: clamp(1.3rem, 3vw, 1.65rem);
        font-weight: 760;
        letter-spacing: -0.03em;
        color: var(--color-text-primary);
        line-height: 1;
    }

    .csd-metric__label {
        font-size: 0.72rem;
        font-weight: 500;
        color: var(--color-text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        line-height: 1.4;
    }

    /* Action links */
    .csd-hero__actions {
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
    }

    .csd-hero__action-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--color-text-secondary);
        text-decoration: none;
        text-transform: uppercase;
        transition: color var(--transition-fast);
        touch-action: manipulation;
    }

    .csd-hero__action-link:hover {
        color: var(--color-text-primary);
    }

    .csd-hero__action-link:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
        border-radius: 2px;
    }

    /* ─────────────────────────────
       Divider
    ───────────────────────────── */
    .csd-divider {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 0;
    }

    /* ─────────────────────────────
       Shared section styles
    ───────────────────────────── */
    .csd-section {
        padding-block: 3rem;
        border-bottom: 1px solid var(--color-border);
        scroll-margin-top: calc(var(--header-height, 68px) + 1.5rem);
    }

    .csd-section__label {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: 0.6rem;
        opacity: 0.7;
    }

    .csd-section__heading {
        font-size: clamp(1.35rem, 3.5vw, 1.75rem);
        font-weight: 740;
        letter-spacing: -0.035em;
        line-height: 1.15;
        color: var(--color-text-primary);
        margin-bottom: 1.5rem;
    }

    .csd-prose {
        font-size: 0.95rem;
        color: var(--color-text-secondary);
        line-height: 1.75;
        max-width: 72ch;
    }

    .csd-prose--mb {
        margin-bottom: 1.75rem;
    }

    /* ─────────────────────────────
       Architecture layers
    ───────────────────────────── */
    .csd-arch-layers {
        display: flex;
        flex-direction: column;
        gap: 1px;
        border: 1px solid var(--color-border);
        border-radius: 0.875rem;
        overflow: hidden;
        background: var(--color-border);
    }

    .csd-arch-layer {
        background: var(--color-surface);
        padding: 1.5rem 1.75rem;
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.85rem;
    }

    @mixin tablet-up {
        .csd-arch-layer {
            grid-template-columns: 160px 1fr;
            grid-template-rows: auto auto;
            column-gap: 2rem;
        }

        .csd-arch-layer__header {
            grid-row: 1;
            grid-column: 1;
            padding-top: 0.15rem;
        }

        .csd-arch-layer__chips {
            grid-row: 1;
            grid-column: 2;
        }

        .csd-arch-layer__desc {
            grid-row: 2;
            grid-column: 2;
        }
    }

    .csd-arch-layer__name {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-accent);
    }

    .csd-arch-layer__chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .csd-arch-chip {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.25rem 0.7rem;
        border-radius: 0.35rem;
        background: color-mix(in srgb, var(--color-accent) 6%, transparent);
        border: 1px solid color-mix(in srgb, var(--color-accent) 18%, transparent);
        color: var(--color-text-primary);
    }

    .csd-arch-layer__desc {
        font-size: 0.84rem;
        color: var(--color-text-secondary);
        line-height: 1.65;
        margin: 0;
    }

    /* ─────────────────────────────
       Implementation highlights
    ───────────────────────────── */
    .csd-highlights {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .csd-highlight {
        border-left: 2px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
        padding-left: 1.5rem;
    }

    .csd-highlight__title {
        font-size: 1rem;
        font-weight: 680;
        color: var(--color-text-primary);
        letter-spacing: -0.02em;
        margin-bottom: 0.6rem;
    }

    .csd-highlight__desc {
        font-size: 0.88rem;
        color: var(--color-text-secondary);
        line-height: 1.7;
        margin-bottom: 1rem;
        max-width: 68ch;
    }

    /* Code block */
    .csd-code-block {
        border-radius: 0.65rem;
        overflow: hidden;
        border: 1px solid var(--color-border);
        background: #070d18;
    }

    .csd-code-block__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.55rem 1rem;
        border-bottom: 1px solid var(--color-border);
        background: color-mix(in srgb, var(--color-accent) 4%, transparent);
    }

    .csd-code-block__lang {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-accent);
        opacity: 0.75;
    }

    .csd-code-block__copy {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: transparent;
        border: none;
        cursor: pointer;
        color: var(--color-text-secondary);
        font-size: 0.7rem;
        font-weight: 600;
        font-family: var(--font-sans);
        letter-spacing: 0.04em;
        padding: 0.2rem 0.4rem;
        border-radius: 0.3rem;
        transition: color var(--transition-fast);
    }

    .csd-code-block__copy:hover {
        color: var(--color-text-primary);
