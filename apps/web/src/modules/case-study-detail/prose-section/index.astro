---
export interface Props {
    id: string;
    number: string;
    heading: string;
    body: string;
}

const { id, number, heading, body } = Astro.props;
---

<section class="csd-section" id={id} data-animate aria-labelledby={`${id}-heading`}>
    <p class="csd-section__label">{number}</p>
    <h2 class="csd-section__heading" id={`${id}-heading`}>{heading}</h2>
    <p class="csd-prose">{body}</p>
</section>

<style>
    @import "../../../styles/mixins.css";

    .csd-section {
        padding-block: clamp(2.2rem, 5vw, 3rem);
        border-bottom: 1px solid var(--color-border);
        scroll-margin-top: calc(var(--header-height, 68px) + 1.5rem);
    }

    .csd-section__label {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: 0.6rem;
        opacity: 0.7;
    }

    .csd-section__heading {
        font-size: clamp(1.35rem, 3.5vw, 1.75rem);
        font-weight: 740;
        letter-spacing: -0.035em;
        line-height: 1.15;
        color: var(--color-text-primary);
        margin-bottom: 1.5rem;
    }

    .csd-prose {
        font-size: 0.94rem;
        color: var(--color-text-secondary);
        line-height: 1.75;
        max-width: 72ch;
        padding: 1rem;
        border: 1px solid rgba(120, 196, 247, 0.14);
        border-radius: 0.75rem;
        background: rgba(16, 26, 38, 0.42);
    }
</style>
