---
import { APP_ROUTES } from "@/constants/routes";
---

<section class="bp" aria-labelledby="bp-heading">
    <div class="bp__inner layout-container">
        <header class="bp__header">
            <div class="bp__header-text">
                <p class="bp__label section-kicker" data-animate data-animate-delay="1">
                    Field Notes
                </p>
                <h2 class="bp__heading" id="bp-heading" data-animate data-animate-delay="2">
                    From the Blog
                </h2>
                <p class="bp__subtext" data-animate data-animate-delay="3">
                    Notes on architecture, performance, and production tradeoffs.
                </p>
            </div>
            <a href={APP_ROUTES.BLOG.ROOT} class="bp__cta-link" data-animate data-animate-delay="3">
                View all posts <span aria-hidden="true">→</span>
            </a>
        </header>

        <div class="bp__empty" data-animate data-animate-delay="2">
            <p class="bp__empty-text">
                No posts yet. New writing on production systems lands soon.
            </p>
        </div>

        <div class="bp__cta-mobile">
            <a href={APP_ROUTES.BLOG.ROOT} class="bp__cta-link">
                View all posts <span aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</section>

<style>
    @import "../../../styles/mixins.css";

    .bp {
        position: relative;
        z-index: 1;
        padding-block: clamp(3rem, 6vw, 4.6rem);
    }

    .bp__inner {
        position: relative;
    }

    /* ── Header ── */
    .bp__header {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-bottom: 2.5rem;
    }

    @mixin desktop-up {
        .bp__header {
            flex-direction: row;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 3rem;
        }
    }

    .bp__label {
        margin-bottom: 0.75rem;
    }

    .bp__heading {
        font-size: clamp(1.75rem, 6vw, 2.5rem);
        font-weight: 760;
        letter-spacing: -0.04em;
        color: var(--color-text-primary);
        line-height: 1.1;
        margin-bottom: 0.75rem;
        text-wrap: balance;
    }

    .bp__subtext {
        font-size: clamp(0.95rem, 2.5vw, 1.05rem);
        color: var(--color-text-secondary);
        line-height: 1.65;
        max-width: 44ch;
    }

    /* Desktop CTA next to header */
    .bp__cta-link {
        display: none;
        font-size: 0.74rem;
        font-weight: 650;
        color: var(--color-accent);
        text-transform: uppercase;
        letter-spacing: 0.09em;
        white-space: nowrap;
        transition: opacity var(--transition-fast);
        padding-bottom: 0.2rem;
    }

    .bp__cta-link:hover {
        opacity: 0.75;
    }

    @mixin desktop-up {
        .bp__cta-link {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }
    }

    /* Mobile CTA below placeholder */
    .bp__cta-mobile {
        margin-top: 2rem;
        display: flex;
    }

    .bp__cta-mobile .bp__cta-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    @mixin desktop-up {
        .bp__cta-mobile {
            display: none;
        }
    }

    /* ── Empty state ── */
    .bp__empty {
        padding: clamp(2rem, 4vw, 2.8rem) clamp(1rem, 3vw, 2rem);
        border: 1px solid var(--color-border);
        border-radius: 1rem;
        background: linear-gradient(180deg, rgba(16, 26, 38, 0.85), rgba(11, 18, 27, 0.88));
        text-align: center;
    }

    .bp__empty-text {
        font-size: clamp(0.95rem, 2vw, 1.05rem);
        color: var(--color-text-secondary);
        line-height: 1.65;
        max-width: 52ch;
        margin: 0 auto;
    }

    @media (prefers-reduced-motion: reduce) {
        .bp__empty {
            transition: none;
        }
    }
</style>

<script>
    import { initScrollReveal } from "@/utils/animations";
    initScrollReveal();
</script>
