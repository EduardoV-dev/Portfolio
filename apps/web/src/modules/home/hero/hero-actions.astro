---
import { APP_ROUTES } from "@/constants/routes";
---

<div class="hero-actions">
    <a href={APP_ROUTES.CASE_STUDIES.ROOT} class="hero-btn hero-btn--primary">
        <span>View Case Studies</span>
        <span aria-hidden="true">&rarr;</span>
    </a>
    <a href={`${APP_ROUTES.CONTACT}#book-a-call`} class="hero-btn hero-btn--secondary">
        <span>Let's Build Something</span>
    </a>
</div>

<style>
    @import "../../../styles/mixins.css";

    .hero-actions {
        display: flex;
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        gap: 0.9rem;
        animation: hero-fade-up 480ms ease both;
        animation-delay: 280ms;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        width: 100%;
        min-height: 3.6rem;
        padding: 0.9rem 1.5rem;
        border-radius: 0.95rem;
        border: 1px solid transparent;
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        touch-action: manipulation;
        transition:
            transform var(--transition-fast),
            box-shadow var(--transition-base),
            border-color var(--transition-fast),
            background var(--transition-fast);
    }

    .hero-btn--primary {
        color: #081723;
        background: linear-gradient(140deg, var(--color-cta-bg) 0%, var(--color-accent) 100%);
        box-shadow:
            0 12px 30px rgba(95, 193, 238, 0.25),
            inset 0 -1px 0 rgba(255, 255, 255, 0.25);
    }

    .hero-btn--secondary {
        color: var(--color-text-primary);
        background: linear-gradient(180deg, rgba(24, 34, 46, 0.7) 0%, rgba(16, 23, 34, 0.9) 100%);
        border-color: var(--color-border);
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.28);
    }

    .hero-btn:hover {
        transform: translateY(-2px);
    }

    .hero-btn--primary:hover {
        box-shadow:
            0 15px 34px rgba(95, 193, 238, 0.35),
            inset 0 -1px 0 rgba(255, 255, 255, 0.3);
    }

    .hero-btn--secondary:hover {
        border-color: rgba(105, 217, 255, 0.45);
        box-shadow: 0 14px 28px rgba(6, 14, 22, 0.4);
    }

    .hero-btn:focus-visible {
        outline: 2px solid rgba(0, 204, 255, 0.95);
        outline-offset: 2px;
    }

    .hero-btn:active {
        transform: translateY(0);
    }

    @mixin tablet-up {
        .hero-actions {
            width: auto;
            flex-direction: row;
            align-items: center;
            gap: 0.9rem;
            flex-wrap: wrap;
        }

        .hero-btn {
            width: auto;
            min-height: 3.45rem;
            border-radius: 0.8rem;
            font-size: 0.84rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-actions,
        .hero-btn {
            animation: none;
            transition: none;
        }
    }

    @media (max-width: 390px) {
        .hero-btn {
            min-height: 3.3rem;
            padding: 0.8rem 1rem;
            font-size: 0.78rem;
        }
    }

    @media (max-width: 320px) {
        .hero-actions {
            gap: 0.65rem;
        }

        .hero-btn {
            min-height: 3.1rem;
            font-size: 0.74rem;
            letter-spacing: 0.06em;
        }
    }
</style>
