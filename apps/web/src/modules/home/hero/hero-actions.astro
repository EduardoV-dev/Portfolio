---
import { APP_ROUTES } from "@/constants/routes";
---

<div class="hero-actions">
    <a href={APP_ROUTES.CASE_STUDIES.ROOT} class="hero-btn hero-btn--primary">
        <span>View Case Studies</span>
        <span aria-hidden="true">&rarr;</span>
    </a>
    <a href={`${APP_ROUTES.CONTACT}#book-a-call`} class="hero-btn hero-btn--secondary">
        <span>Let's Build Something</span>
    </a>
</div>

<style>
    @import "../../../styles/mixins.css";

    .hero-actions {
        display: flex;
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        gap: 0.85rem;
        animation: hero-fade-up 480ms ease both;
        animation-delay: 280ms;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        width: 100%;
        min-height: 3.9rem;
        padding: 0.95rem 1.8rem;
        border-radius: 0.95rem;
        border: 1px solid transparent;
        font-size: 1.03rem;
        font-weight: 650;
        letter-spacing: -0.01em;
        touch-action: manipulation;
        transition:
            transform var(--transition-fast),
            box-shadow var(--transition-base),
            border-color var(--transition-fast),
            background var(--transition-fast);
    }

    .hero-btn--primary {
        color: #04131f;
        background: linear-gradient(135deg, #33ddff 0%, #00ccff 52%, #00d5ff 100%);
        box-shadow:
            0 12px 30px rgba(0, 204, 255, 0.25),
            inset 0 -1px 0 rgba(255, 255, 255, 0.25);
    }

    .hero-btn--secondary {
        color: var(--color-text-primary);
        background: linear-gradient(180deg, rgba(26, 30, 36, 0.8) 0%, rgba(20, 23, 28, 0.94) 100%);
        border-color: rgba(255, 255, 255, 0.1);
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.28);
    }

    .hero-btn:hover {
        transform: translateY(-2px);
    }

    .hero-btn--primary:hover {
        box-shadow:
            0 15px 34px rgba(0, 204, 255, 0.35),
            inset 0 -1px 0 rgba(255, 255, 255, 0.3);
    }

    .hero-btn--secondary:hover {
        border-color: rgba(0, 204, 255, 0.45);
        box-shadow: 0 14px 28px rgba(6, 14, 22, 0.4);
    }

    .hero-btn:focus-visible {
        outline: 2px solid rgba(0, 204, 255, 0.95);
        outline-offset: 2px;
    }

    .hero-btn:active {
        transform: translateY(0);
    }

    @mixin tablet-up {
        .hero-actions {
            width: auto;
            flex-direction: row;
            align-items: center;
            gap: 0.9rem;
            flex-wrap: wrap;
        }

        .hero-btn {
            width: auto;
            min-height: 3.7rem;
            border-radius: 0.85rem;
            font-size: 1.05rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-actions,
        .hero-btn {
            animation: none;
            transition: none;
        }
    }
</style>
