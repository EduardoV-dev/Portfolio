---
import HeroActions from "./hero-actions.astro";
---

<div class="hero-content">
    <p class="hero-status">AVAILABLE FOR SCALE-UP PROJECTS</p>

    <h1 class="hero-title">
        I build scalable web
        <br />
        platforms that drive
        <br />
        <span>real business</span>
        <br />
        <span>growth.</span>
    </h1>

    <p class="hero-description">
        Full Stack Engineer with 4+ years of experience designing high-performance React, Node.js,
        Go and AWS-based systems for production environments.
    </p>

    <HeroActions />
</div>

<style>
    @import "../../../styles/mixins.css";

    .hero-content {
        display: flex;
        flex-direction: column;
        gap: 1.3rem;
        max-width: 100%;
    }

    .hero-status {
        align-self: flex-start;
        padding: 0.42rem 0.86rem;
        border-radius: 999px;
        border: 1px solid rgba(56, 189, 248, 0.42);
        color: var(--color-accent);
        font-size: 0.86rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        line-height: 1;
        background: linear-gradient(90deg, rgba(56, 189, 248, 0.15), rgba(56, 189, 248, 0.04));
        animation: hero-fade-up 500ms ease both;
        animation-delay: 40ms;
    }

    .hero-status::before {
        content: "";
        display: inline-block;
        width: 0.45rem;
        height: 0.45rem;
        margin-right: 0.55rem;
        border-radius: 50%;
        background: var(--color-accent);
        box-shadow: 0 0 0 6px rgba(56, 189, 248, 0.14);
        vertical-align: middle;
    }

    .hero-title {
        font-size: clamp(2.2rem, 11vw, 3.2rem);
        line-height: 0.96;
        letter-spacing: -0.04em;
        font-weight: 760;
        color: #e9eef4;
        text-wrap: balance;
        animation: hero-fade-up 560ms ease both;
        animation-delay: 120ms;
    }

    .hero-title span {
        color: #40b9ff;
        text-shadow: 0 0 22px rgba(64, 185, 255, 0.18);
    }

    .hero-description {
        max-width: 100%;
        color: var(--color-text-secondary);
        font-size: clamp(1.07rem, 5.3vw, 1.3rem);
        line-height: 1.52;
        letter-spacing: -0.012em;
        text-wrap: pretty;
        animation: hero-fade-up 520ms ease both;
        animation-delay: 200ms;
    }

    @mixin tablet-up {
        .hero-content {
            gap: 1.65rem;
        }

        .hero-title {
            line-height: 0.98;
            font-size: clamp(2.35rem, 11.8vw, 3.75rem);
        }

        .hero-status {
            font-size: 0.95rem;
            letter-spacing: 0.02em;
            padding: 0.42rem 1rem;
        }

        .hero-description {
            font-size: clamp(1.08rem, 3.2vw, 1.3rem);
        }
    }

    @mixin desktop-up {
        .hero-content {
            max-width: 38rem;
        }

        .hero-title {
            font-size: clamp(2.45rem, 3.8vw, 3.8rem);
            line-height: 0.97;
        }

        .hero-description {
            max-width: 34rem;
            font-size: clamp(1rem, 1.1vw, 1.15rem);
            line-height: 1.6;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-status,
        .hero-title,
        .hero-description {
            animation: none;
        }
    }

    @keyframes hero-fade-up {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
