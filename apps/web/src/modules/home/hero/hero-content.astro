---
import { YEARS_OF_PROFESSIONAL_EXPERIENCE } from "@/constants/common";
import HeroActions from "./hero-actions.astro";
---

<div class="hero-content">
    <p class="hero-status">Open to focused product and platform roles</p>

    <h1 class="hero-title">
        I build and ship
        <br />
        production-ready systems
        <br />
        <span>that move product and revenue metrics.</span>
    </h1>

    <p class="hero-description">
        Full Stack Engineer with {YEARS_OF_PROFESSIONAL_EXPERIENCE}+ years shipping web products
        across frontend, backend, and cloud. I choose architecture based on team velocity,
        reliability targets, and business goals.
    </p>

    <HeroActions />
</div>

<style>
    @import "../../../styles/mixins.css";

    .hero-content {
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
        max-width: 100%;
    }

    .hero-status {
        align-self: flex-start;
        padding: 0.5rem 0.86rem;
        border-radius: 999px;
        border: 1px solid rgba(116, 181, 232, 0.46);
        color: var(--color-accent);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        line-height: 1;
        background: linear-gradient(90deg, rgba(97, 165, 219, 0.22), rgba(97, 165, 219, 0.06));
        animation: hero-fade-up 500ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: 40ms;
    }

    .hero-status::before {
        content: "";
        display: inline-block;
        width: 0.4rem;
        height: 0.4rem;
        margin-right: 0.55rem;
        border-radius: 50%;
        background: var(--color-accent);
        box-shadow: 0 0 0 6px rgba(93, 167, 226, 0.18);
        vertical-align: middle;
    }

    .hero-title {
        font-size: clamp(2.2rem, 10.8vw, 3.4rem);
        line-height: 0.98;
        letter-spacing: -0.034em;
        font-weight: 760;
        font-optical-sizing: auto;
        color: #e9eef4;
        text-wrap: balance;
        animation: hero-fade-up 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: 120ms;
    }

    .hero-title span {
        color: #8de6ff;
        text-shadow: 0 0 24px rgba(95, 192, 238, 0.22);
    }

    .hero-description {
        max-width: 100%;
        color: var(--color-text-secondary);
        font-size: clamp(1.02rem, 4.6vw, 1.2rem);
        line-height: 1.63;
        letter-spacing: -0.012em;
        text-wrap: pretty;
        animation: hero-fade-up 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: 200ms;
    }

    @mixin tablet-up {
        .hero-content {
            gap: 1.65rem;
        }

        .hero-title {
            line-height: 1;
            font-size: clamp(2.35rem, 11.8vw, 3.9rem);
        }

        .hero-status {
            font-size: 0.74rem;
            letter-spacing: 0.11em;
            padding: 0.55rem 1rem;
        }

        .hero-description {
            font-size: clamp(1.06rem, 2.6vw, 1.2rem);
        }
    }

    @mixin desktop-up {
        .hero-content {
            max-width: 38rem;
        }

        .hero-title {
            font-size: clamp(2.45rem, 3.8vw, 3.8rem);
            line-height: 1;
        }

        .hero-description {
            max-width: 34rem;
            font-size: clamp(1rem, 1.1vw, 1.15rem);
            line-height: 1.6;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-status,
        .hero-title,
        .hero-description {
            animation: none;
        }
    }

    @keyframes hero-fade-up {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 390px) {
        .hero-content {
            gap: 1.1rem;
        }

        .hero-title {
            font-size: clamp(2rem, 11vw, 2.7rem);
        }
    }

    @media (max-width: 320px) {
        .hero-status {
            font-size: 0.64rem;
            padding: 0.45rem 0.68rem;
        }

        .hero-description {
            font-size: 0.92rem;
            line-height: 1.56;
        }
    }
</style>
