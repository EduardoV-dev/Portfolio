---
import analyticsIcon from "../assets/analytics.svg";
import authIcon from "../assets/auth.svg";
import cachingIcon from "../assets/caching.svg";
import dataLayerIcon from "../assets/data-layer.svg";
import paymentIcon from "../assets/payment.svg";
import platformCoreIcon from "../assets/platform-core.svg";
---

<aside class="hero-visual" aria-label="Platform architecture diagram">
    <div class="hero-visual__glow" aria-hidden="true"></div>

    <div class="diagram" aria-hidden="true">
        <div class="diagram__orbit"></div>

        <div class="diagram__axis diagram__axis--vertical"></div>
        <div class="diagram__axis diagram__axis--stub-left"></div>
        <div class="diagram__axis diagram__axis--stub-right"></div>
        <div class="diagram__axis diagram__axis--stub-bottom-left"></div>
        <div class="diagram__axis diagram__axis--stub-bottom-right"></div>

        <div class="diagram__node diagram__node--top">
            <span class="diagram__api">API</span>
        </div>
        <p class="diagram__label diagram__label--top">Api Gateway</p>

        <div class="diagram__node diagram__node--left">
            <img src={authIcon.src} alt="" loading="lazy" decoding="async" />
        </div>
        <p class="diagram__label diagram__label--left">Auth</p>

        <div class="diagram__node diagram__node--right">
            <img src={analyticsIcon.src} alt="" loading="lazy" decoding="async" />
        </div>
        <p class="diagram__label diagram__label--right">Analytics</p>

        <div class="diagram__node diagram__node--bottom-left">
            <img src={paymentIcon.src} alt="" loading="lazy" decoding="async" />
        </div>
        <p class="diagram__label diagram__label--bottom-left">Payments</p>

        <div class="diagram__node diagram__node--bottom-right">
            <img src={cachingIcon.src} alt="" loading="lazy" decoding="async" />
        </div>
        <p class="diagram__label diagram__label--bottom-right">Caching</p>

        <div class="diagram__node diagram__node--bottom">
            <img src={dataLayerIcon.src} alt="" loading="lazy" decoding="async" />
        </div>
        <p class="diagram__label diagram__label--bottom">Data Layer</p>

        <div class="diagram__core">
            <div class="diagram__core-inner">
                <img src={platformCoreIcon.src} alt="" loading="lazy" decoding="async" />
            </div>
            <p class="diagram__core-label">Platform Core</p>
        </div>
    </div>
</aside>

<style>
    @import "../../../styles/mixins.css";

    .hero-visual {
        display: none;
        position: relative;
        align-items: center;
        justify-content: center;
        min-height: 28rem;
        animation: hero-fade-up 420ms ease both;
        animation-delay: 120ms;
        isolation: isolate;
    }

    .hero-visual__glow {
        position: absolute;
        inset: 6% 8%;
        background:
            repeating-linear-gradient(
                90deg,
                rgba(9, 70, 112, 0.11) 0,
                rgba(9, 70, 112, 0.11) 12px,
                rgba(5, 16, 31, 0.01) 12px,
                rgba(5, 16, 31, 0.01) 52px
            ),
            radial-gradient(
                circle at 50% 50%,
                rgba(56, 189, 248, 0.2),
                rgba(56, 189, 248, 0.06) 48%,
                transparent 70%
            ),
            radial-gradient(circle at 30% 68%, rgba(56, 189, 248, 0.06), transparent 62%);
        filter: blur(10px);
        pointer-events: none;
        animation:
            glow-fade-in 700ms ease both 200ms,
            glow-breathe 5s ease-in-out infinite 900ms;
    }

    .diagram {
        position: relative;
        width: min(100%, 31.5rem);
        aspect-ratio: 1 / 1;
        transform: translateX(0);
        --line-color: rgba(58, 176, 248, 0.94);
        --label-color: rgba(70, 180, 245, 0.96);
    }

    .diagram__orbit {
        position: absolute;
        inset: 6.8%;
        border-radius: 50%;
        border: 1.5px dashed rgba(58, 176, 248, 0.84);
        z-index: 1;
        animation:
            orbit-enter 600ms cubic-bezier(0.34, 1.56, 0.64, 1) both 300ms,
            orbit-spin 18s linear infinite 900ms;
    }

    .diagram__axis {
        position: absolute;
        height: 2px;
        background: repeating-linear-gradient(
            90deg,
            var(--line-color) 0,
            var(--line-color) 6px,
            transparent 6px,
            transparent 20px
        );
        opacity: 0.96;
        animation: axis-reveal 520ms ease both;
        z-index: 2;
        overflow: visible;
    }

    .diagram__axis::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 0;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: rgba(58, 176, 248, 0.95);
        box-shadow: 0 0 6px 2px rgba(58, 176, 248, 0.55);
        /* transform moved into keyframe — animating left triggers layout */
        animation: particle-travel 3s linear infinite;
        opacity: 0;
    }

    .diagram__axis--vertical {
        left: 50%;
        top: 15.32%;
        width: 4px;
        height: 68.56%;
        transform: translateX(-50%);
        background: repeating-linear-gradient(
            180deg,
            var(--line-color) 0,
            var(--line-color) 6px,
            transparent 6px,
            transparent 20px
        );
    }

    .diagram__axis--vertical::after {
        top: 0;
        left: 50%;
        /* transform moved into keyframe — animating top triggers layout */
        animation: particle-travel-vertical 3.2s linear infinite 0.4s;
    }

    /* Stub: Auth node inner edge → Platform Core edge */
    /* Auth node center (12.59%, 28.40%), inner edge at (19.96%, 32.66%) */
    /* Core edge at (35.91%, 41.87%), length=18.42%, angle=30deg */
    .diagram__axis--stub-left {
        left: 19.96%;
        top: 32.66%;
        width: 18.42%;
        transform: rotate(30deg);
        transform-origin: left center;
        animation-delay: 80ms;
    }

    .diagram__axis--stub-left::after {
        animation-delay: 0.8s;
    }

    /* Stub: Analytics node inner edge → Platform Core edge */
    /* Analytics node center (87.41%, 28.40%), inner edge at (80.04%, 32.66%) */
    /* Core edge at (64.09%, 41.87%), length=18.42%, angle=150deg */
    .diagram__axis--stub-right {
        left: 80.04%;
        top: 32.66%;
        width: 18.42%;
        transform: rotate(150deg);
        transform-origin: left center;
        animation-delay: 80ms;
    }

    .diagram__axis--stub-right::after {
        animation-delay: 1.6s;
    }

    /* Stub: Payments node inner edge → Platform Core edge */
    /* Payments node center (12.59%, 71.60%), inner edge at (19.41%, 67.66%) */
    /* Core edge at (35.91%, 58.13%), length=19.06%, angle=-30deg */
    .diagram__axis--stub-bottom-left {
        left: 19.41%;
        top: 67.66%;
        width: 19.06%;
        transform: rotate(-30deg);
        transform-origin: left center;
        animation-delay: 120ms;
    }

    .diagram__axis--stub-bottom-left::after {
        animation-delay: 2.4s;
    }

    /* Stub: Caching node inner edge → Platform Core edge */
    /* Caching node center (87.41%, 71.60%), inner edge at (80.59%, 67.66%) */
    /* Core edge at (64.09%, 58.13%), length=19.06%, angle=-150deg */
    .diagram__axis--stub-bottom-right {
        left: 80.59%;
        top: 67.66%;
        width: 19.06%;
        transform: rotate(-150deg);
        transform-origin: left center;
        animation-delay: 120ms;
    }

    .diagram__axis--stub-bottom-right::after {
        animation-delay: 3.2s;
    }

    .diagram__node {
        position: absolute;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 2px solid rgba(58, 176, 248, 0.75);
        background: linear-gradient(180deg, rgba(8, 14, 21, 0.97), rgba(6, 11, 18, 0.99));
        box-shadow:
            0 0 0 1px rgba(255, 255, 255, 0.015) inset,
            0 18px 28px rgba(2, 7, 13, 0.55);
        border-radius: 1.25rem;
        z-index: 3;
        animation:
            node-enter 500ms cubic-bezier(0.34, 1.56, 0.64, 1) both,
            node-float 4s ease-in-out infinite;
    }

    .diagram__node::before {
        content: "";
        position: absolute;
        width: 58%;
        aspect-ratio: 1 / 1;
        border-radius: 50%;
        background: rgba(19, 65, 97, 0.7);
    }

    .diagram__node img {
        position: relative;
        z-index: 1;
        width: 1.5rem;
        height: 1.5rem;
        object-fit: contain;
        opacity: 1;
    }

    .diagram__node--top {
        top: -1.72%;
        left: 50%;
        width: 5.3rem;
        height: 5.3rem;
        transform: translateX(-50%);
        border-radius: 1.25rem;
        animation:
            node-enter-centered 500ms cubic-bezier(0.34, 1.56, 0.64, 1) both 300ms,
            node-float 4s ease-in-out infinite 0s;
    }

    .diagram__node--top::before {
        display: none;
    }

    .diagram__api {
        font-size: 2.1rem;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -0.04em;
        color: #40b9ff;
        text-shadow: 0 0 22px rgba(64, 185, 255, 0.2);
    }

    .diagram__node--left {
        top: 19.88%;
        left: 4.07%;
        width: 5.3rem;
        height: 5.3rem;
        animation-delay: 420ms, 0.7s;
    }

    .diagram__node--right {
        top: 19.88%;
        right: 4.07%;
        width: 5.3rem;
        height: 5.3rem;
        animation-delay: 420ms, 1.4s;
    }

    .diagram__node--bottom-left {
        left: 4.72%;
        bottom: 20.53%;
        width: 4.9rem;
        height: 4.9rem;
        animation-delay: 540ms, 2.1s;
    }

    .diagram__node--bottom-right {
        right: 4.72%;
        bottom: 20.53%;
        width: 4.9rem;
        height: 4.9rem;
        animation-delay: 540ms, 2.8s;
    }

    .diagram__node--bottom {
        left: 50%;
        bottom: -2.52%;
        width: 5.8rem;
        height: 5.8rem;
        transform: translateX(-50%);
        border-radius: 1.25rem;
        animation:
            node-enter-centered 500ms cubic-bezier(0.34, 1.56, 0.64, 1) both 660ms,
            node-float 4s ease-in-out infinite 3.5s;
    }

    .diagram__node--bottom img {
        width: 1.8rem;
        height: auto;
    }

    .diagram__core {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 10.7rem;
        height: 10.7rem;
        border-radius: 999px;
        border: 4px dashed rgba(58, 176, 248, 0.23);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 3;
        animation: core-enter 600ms cubic-bezier(0.34, 1.56, 0.64, 1) both 480ms;
    }

    .diagram__core-inner {
        position: relative;
        width: 7.55rem;
        height: 7.55rem;
        border-radius: 999px;
        border: 0.75rem solid rgba(58, 176, 248, 0.96);
        background: radial-gradient(
            circle at 50% 35%,
            rgba(17, 31, 45, 0.96),
            rgba(8, 16, 23, 0.98)
        );
        display: grid;
        place-items: center;
        /* static base glow — no repaint */
        box-shadow: 0 0 18px rgba(58, 176, 248, 0.2);
        animation: core-pulse 3s ease-in-out infinite 1.1s;
    }

    /* Pulsing outer glow via opacity — GPU composited, no repaint */
    .diagram__core-inner::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        box-shadow: 0 0 32px rgba(58, 176, 248, 0.45);
        opacity: 0;
        pointer-events: none;
        animation: core-glow 3s ease-in-out infinite 1.1s;
    }

    .diagram__core-inner img {
        width: 2.55rem;
        height: 2.55rem;
    }

    .diagram__core-label {
        position: absolute;
        left: 50%;
        top: calc(100% + 0.55rem);
        transform: translateX(-50%);
        color: var(--label-color);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        white-space: nowrap;
    }

    .diagram__label {
        position: absolute;
        color: var(--label-color);
        font-size: 0.86rem;
        font-weight: 550;
        letter-spacing: 0.01em;
        text-shadow: 0 0 10px rgba(60, 175, 246, 0.2);
        animation: label-fade 400ms ease both;
    }

    .diagram__label--top {
        left: 50%;
        top: 16.82%;
        transform: translateX(-50%);
        font-size: 0.95rem;
        font-weight: 650;
        animation-delay: 500ms;
    }

    /* Auth label: below the Auth node. Auth node center=(12.59%,28.40%), bottom=36.92% */
    .diagram__label--left {
        left: 12.59%;
        top: 38.42%;
        transform: translateX(-50%);
        animation-delay: 620ms;
    }

    /* Analytics label: below the Analytics node. Analytics node center=(87.41%,28.40%) */
    .diagram__label--right {
        left: 87.41%;
        top: 38.42%;
        transform: translateX(-50%);
        animation-delay: 620ms;
    }

    /* Payments label: below the Payments node. Payments node center=(12.59%,71.60%) */
    .diagram__label--bottom-left {
        left: 12.59%;
        top: 80.97%;
        transform: translateX(-50%);
        animation-delay: 740ms;
    }

    /* Caching label: below the Caching node. Caching node center=(87.41%,71.60%) */
    .diagram__label--bottom-right {
        left: 87.41%;
        top: 80.97%;
        transform: translateX(-50%);
        animation-delay: 740ms;
    }

    .diagram__label--bottom {
        left: 50%;
        bottom: -12.82%;
        transform: translateX(-50%);
        font-size: 0.95rem;
        font-weight: 600;
        animation-delay: 860ms;
    }

    @mixin desktop-up {
        .hero-visual {
            display: flex;
            min-height: 34rem;
            overflow: visible;
        }

        .diagram {
            width: clamp(28rem, 100%, 37rem);
            transform: translateX(0.5rem);
        }
    }

    /* Small desktop: labels overlap nodes due to narrower column — push them down */
    @media (min-width: 1025px) and (max-width: 1279px) {
        .diagram__label--top {
            top: 20%;
        }

        .diagram__label--left {
            top: 42%;
        }

        .diagram__label--right {
            top: 42%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-visual,
        .hero-visual__glow,
        .diagram__axis,
        .diagram__axis::after,
        .diagram__orbit,
        .diagram__node,
        .diagram__node--top,
        .diagram__node--bottom,
        .diagram__label,
        .diagram__core,
        .diagram__core-inner,
        .diagram__core-inner::after {
            animation: none;
        }

        .hero-visual__glow {
            opacity: 0.82;
        }

        .diagram__orbit {
            opacity: 0.96;
        }

        .diagram__node--top,
        .diagram__node--bottom {
            transform: translateX(-50%);
        }
    }

    @keyframes hero-fade-up {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes glow-fade-in {
        from {
            opacity: 0;
        }

        to {
            opacity: 0.82;
        }
    }

    @keyframes glow-breathe {
        0%,
        100% {
            opacity: 0.65;
        }

        50% {
            opacity: 0.88;
        }
    }

    @keyframes orbit-enter {
        from {
            opacity: 0;
            transform: scale(0.6);
        }

        to {
            opacity: 0.96;
            transform: scale(1);
        }
    }

    @keyframes orbit-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @keyframes node-enter {
        from {
            opacity: 0;
            transform: scale(0.7);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @keyframes node-enter-centered {
        from {
            opacity: 0;
            transform: translateX(-50%) scale(0.7);
        }

        to {
            opacity: 1;
            transform: translateX(-50%) scale(1);
        }
    }

    @keyframes node-float {
        0%,
        100% {
            translate: 0 0;
        }

        50% {
            translate: 0 -5px;
        }
    }

    @keyframes label-fade {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @keyframes core-enter {
        from {
            opacity: 0;
            transform: translate(-50%, -50%) scale(0.5);
        }

        to {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1);
        }
    }

    @keyframes core-pulse {
        0%,
        100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.045);
        }
    }

    /* Opacity-only glow pulse — GPU composited, no repaint */
    @keyframes core-glow {
        0%,
        100% {
            opacity: 0;
        }

        50% {
            opacity: 1;
        }
    }

    @keyframes axis-reveal {
        from {
            opacity: 0;
        }

        to {
            opacity: 0.95;
        }
    }

    @keyframes particle-travel {
        0% {
            /* translateY(-50%) centers vertically on the 2px axis line */
            transform: translateX(0px) translateY(-50%);
            opacity: 0;
        }

        10% {
            opacity: 1;
        }

        85% {
            opacity: 1;
        }

        100% {
            /* 115px covers max horizontal axis width (~109px at 37rem diagram) */
            transform: translateX(115px) translateY(-50%);
            opacity: 0;
        }
    }

    @keyframes particle-travel-vertical {
        0% {
            /* translateX(-50%) centers horizontally on the 4px axis line */
            transform: translateX(-50%) translateY(0px);
            opacity: 0;
        }

        10% {
            opacity: 1;
        }

        85% {
            opacity: 1;
        }

        100% {
            /* 420px covers max vertical axis height (~406px at 37rem diagram) */
            transform: translateX(-50%) translateY(420px);
            opacity: 0;
        }
    }
</style>
