---
import HeroContent from "./hero-content.astro";
import HeroVisual from "./hero-visual.astro";
---

<section class="hero" aria-label="Homepage hero">
    <div class="hero__inner">
        <HeroContent />
        <HeroVisual />
    </div>
</section>

<style>
    @import "../../../styles/mixins.css";

    .hero {
        position: relative;
        overflow: clip;
        background: transparent;
        padding-bottom: 2rem;
    }

    .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.05) 0,
            rgba(255, 255, 255, 0) 10%,
            rgba(255, 255, 255, 0) 100%
        );
    }

    .hero__inner {
        position: relative;
        z-index: 1;
        max-width: 1280px;
        margin: 0 auto;
        padding: 2rem 1rem 2.6rem;
        min-height: auto;
        display: grid;
        grid-template-columns: 1fr;
        align-items: start;
        gap: 1.6rem;
    }

    @mixin tablet-up {
        .hero {
            padding-bottom: 0;
        }

        .hero__inner {
            padding-top: clamp(2.4rem, 8vw, 3.4rem);
            padding-bottom: 2rem;
            padding-inline: 1.5rem;
            gap: 2.5rem;
        }
    }

    @mixin desktop-up {
        .hero__inner {
            padding: clamp(2.8rem, 8vh, 6.8rem) 1.5rem clamp(3rem, 8vh, 5.8rem);
            min-height: calc(100vh - var(--header-height, 68px));
            grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
            align-items: center;
            gap: clamp(2rem, 4.2vw, 4rem);
        }
    }
</style>
