---
import productDrivenIcon from "../assets/product-driven-development.svg";
import scalableArchIcon from "../assets/scalable-architecture.svg";
import perfReliabilityIcon from "../assets/performance-and-reliability.svg";
import PhilosophyCard from "./philosophy-card.astro";

const cards = [
    {
        iconSrc: productDrivenIcon.src,
        iconWidth: productDrivenIcon.width,
        iconHeight: productDrivenIcon.height,
        title: "Product-Driven Development",
        description:
            "I tie technical decisions to user behavior and business outcomes. If work does not change one of those, I cut it.",
    },
    {
        iconSrc: scalableArchIcon.src,
        iconWidth: scalableArchIcon.width,
        iconHeight: scalableArchIcon.height,
        title: "Reliable by Default",
        description:
            "I design cloud systems to scale without rewrites, then add failure paths before traffic exposes them.",
    },
    {
        iconSrc: perfReliabilityIcon.src,
        iconWidth: perfReliabilityIcon.width,
        iconHeight: perfReliabilityIcon.height,
        title: "Performance That Ships",
        description:
            "I treat speed and accessibility as release requirements and fix bottlenecks before users hit them.",
    },
];
---

<section class="phil-section" aria-labelledby="phil-heading">
    <div class="phil-section__inner layout-container">
        <!-- Header -->
        <div class="phil-section__header">
            <p class="phil-section__label section-kicker">Operating Principles</p>
            <h2 class="phil-section__heading" id="phil-heading">Engineering That Holds Up</h2>
            <p class="phil-section__subtext">
                You get better outcomes when tradeoffs stay explicit and tied to user and business
                impact.
            </p>
        </div>

        <!-- Cards grid -->
        <ul class="phil-section__grid" role="list">
            {cards.map((card) => <PhilosophyCard {...card} />)}
        </ul>
    </div>
</section>

<style>
    @import "../../../styles/mixins.css";

    .phil-section {
        position: relative;
        z-index: 1;
        padding-block: clamp(3.2rem, 7vw, 5.4rem);
    }

    .phil-section__inner {
        position: relative;
    }

    /* ── Header ── */
    .phil-section__header {
        margin-bottom: 3rem;
    }

    @mixin desktop-up {
        .phil-section__header {
            max-width: 52rem;
            margin-bottom: 3.5rem;
        }
    }

    .phil-section__label {
        margin-bottom: 0.75rem;
    }

    .phil-section__heading {
        font-size: clamp(1.9rem, 6vw, 2.7rem);
        font-weight: 760;
        letter-spacing: -0.04em;
        color: var(--color-text-primary);
        line-height: 1.1;
        margin-bottom: 1.25rem;
    }

    .phil-section__subtext {
        font-size: clamp(1rem, 2.3vw, 1.1rem);
        color: var(--color-text-secondary);
        line-height: 1.65;
        max-width: 48rem;
    }

    /* ── Cards grid ── */
    .phil-section__grid {
        list-style: none;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    @mixin tablet-up {
        .phil-section__grid {
            gap: 1.25rem;
        }
    }

    @mixin desktop-up {
        .phil-section__grid {
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }
    }
</style>
