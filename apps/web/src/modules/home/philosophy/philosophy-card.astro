---
export interface Props {
    iconSrc: string;
    iconWidth: number;
    iconHeight: number;
    title: string;
    description: string;
}

const { iconSrc, iconWidth, iconHeight, title, description } = Astro.props;
---

<li class="phil-card">
    <div class="phil-card__icon-box" aria-hidden="true">
        <img
            src={iconSrc}
            alt=""
            width={iconWidth}
            height={iconHeight}
            loading="lazy"
            decoding="async"
        />
    </div>
    <h3 class="phil-card__title">{title}</h3>
    <p class="phil-card__desc">{description}</p>
</li>

<style>
    @import "../../../styles/mixins.css";

    .phil-card {
        display: flex;
        flex-direction: column;
        gap: 0;
        padding: 1.75rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 1rem;
    }

    @mixin desktop-up {
        .phil-card {
            padding: 2rem;
        }
    }

    /* ── Icon box ── */
    .phil-card__icon-box {
        position: relative;
        flex-shrink: 0;
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 0.9rem;
        border: 1.5px solid rgba(58, 176, 248, 0.32);
        background: linear-gradient(180deg, rgba(8, 14, 21, 0.97), rgba(6, 11, 18, 0.99));
        display: grid;
        place-items: center;
        margin-bottom: 1.5rem;
        box-shadow:
            0 0 0 1px rgba(255, 255, 255, 0.015) inset,
            0 8px 20px rgba(2, 7, 13, 0.45);
    }

    .phil-card__icon-box::before {
        content: "";
        position: absolute;
        width: 60%;
        aspect-ratio: 1 / 1;
        border-radius: 50%;
        background: rgba(19, 65, 97, 0.55);
        pointer-events: none;
    }

    .phil-card__icon-box img {
        position: relative;
        z-index: 1;
        width: 1.4rem;
        height: 1.4rem;
        object-fit: contain;
    }

    /* ── Title ── */
    .phil-card__title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-text-primary);
        letter-spacing: -0.02em;
        line-height: 1.3;
        margin-bottom: 1rem;
    }

    @mixin desktop-up {
        .phil-card__title {
            font-size: 1.05rem;
        }
    }

    /* ── Description ── */
    .phil-card__desc {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
        line-height: 1.65;
    }
</style>
