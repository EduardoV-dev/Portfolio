{
    "compatibility_date": "2026-05-17",
    "compatibility_flags": ["nodejs_compat"],
    "name": "portfolio",
    "main": "@astrojs/cloudflare/entrypoints/server",
    "env": {
        "staging": {
            "vars": {
                "PUBLIC_SENTRY_ENABLED": "true",
                "STRAPI_CMS_OPTIONAL": "false",
                "PUBLIC_ENVIRONMENT": "staging",
                "PUBLIC_GA_MEASUREMENT_ID": "G-CPKFK53CJE",
                "PUBLIC_SITE_URL": "https://stg.eduardov.dev",
                "GITHUB_REPO_OWNER": "EduardoV-dev",
                "GITHUB_REPO_NAME": "portfolio",
                "GITHUB_REBUILD_WORKFLOW_FILE": "deploy-staging.yml",
                "GITHUB_REBUILD_REF": "staging",
            },
        },
        "production": {
            "vars": {
                "PUBLIC_SENTRY_ENABLED": "true",
                "STRAPI_CMS_OPTIONAL": "false",
                "PUBLIC_ENVIRONMENT": "production",
                "PUBLIC_GA_MEASUREMENT_ID": "G-Q8P38XLZGF",
                "PUBLIC_SITE_URL": "https://www.eduardov.dev",
                "GITHUB_REPO_OWNER": "EduardoV-dev",
                "GITHUB_REPO_NAME": "portfolio",
                "GITHUB_REBUILD_WORKFLOW_FILE": "deploy-production.yml",
                "GITHUB_REBUILD_REF": "main",
            },
        },
    },
    "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "404-page",
    },
    "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true,
        },
        "traces": {
            "enabled": true,
            "persist": true,
            "head_sampling_rate": 1,
        },
    },
}
