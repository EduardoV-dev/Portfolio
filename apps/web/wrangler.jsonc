{
    "compatibility_date": "2026-05-17",
    "compatibility_flags": ["nodejs_compat"],
    "name": "portfolio",
    "vars": {
        "PUBLIC_SENTRY_ENABLED": "true",
        "STRAPI_CMS_OPTIONAL": "false",
    },
    "env": {
        "staging": {
            "vars": {
                "PUBLIC_ENVIRONMENT": "staging",
                "PUBLIC_SITE_URL": "https://stg.eduardov.dev",
            },
        },
        "production": {
            "vars": {
                "PUBLIC_ENVIRONMENT": "production",
                "PUBLIC_SITE_URL": "https://www.eduardov.dev",
            },
        },
    },
    "observability": {
        "enabled": true,
    },
}
