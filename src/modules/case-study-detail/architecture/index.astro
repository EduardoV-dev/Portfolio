---
import type { ProjectDetail } from "@/types/strapi";

export interface Props {
    architecture: ProjectDetail["architecture"];
}

const { architecture } = Astro.props;
---

<section class="csd-section" id="architecture" data-animate aria-labelledby="arch-heading">
    <p class="csd-section__label">04</p>
    <h2 class="csd-section__heading" id="arch-heading">System Architecture</h2>
    <p class="csd-prose csd-prose--mb">{architecture?.description}</p>

    <div class="csd-arch-layers">
        {
            architecture.layers.map((layer) => (
                <div class="csd-arch-layer">
                    <div class="csd-arch-layer__header">
                        <span class="csd-arch-layer__name">{layer.name}</span>
                    </div>
                    <div class="csd-arch-layer__chips">
                        {layer.components.map((c) => (
                            <span class="csd-arch-chip">{c.name}</span>
                        ))}
                    </div>
                    <p class="csd-arch-layer__desc">{layer.description}</p>
                </div>
            ))
        }
    </div>
</section>

<style>
    @import "../../../styles/mixins.css";

    .csd-section {
        padding-block: 3rem;
        border-bottom: 1px solid var(--color-border);
        scroll-margin-top: calc(var(--header-height, 68px) + 1.5rem);
    }

    .csd-section__label {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: 0.6rem;
        opacity: 0.7;
    }

    .csd-section__heading {
        font-size: clamp(1.35rem, 3.5vw, 1.75rem);
        font-weight: 740;
        letter-spacing: -0.035em;
        line-height: 1.15;
        color: var(--color-text-primary);
        margin-bottom: 1.5rem;
    }

    .csd-prose {
        font-size: 0.95rem;
        color: var(--color-text-secondary);
        line-height: 1.75;
        max-width: 72ch;
    }

    .csd-prose--mb {
        margin-bottom: 1.75rem;
    }

    .csd-arch-layers {
        display: flex;
        flex-direction: column;
        gap: 1px;
        border: 1px solid var(--color-border);
        border-radius: 0.875rem;
        overflow: hidden;
        background: var(--color-border);
    }

    .csd-arch-layer {
        background: var(--color-surface);
        padding: 1.5rem 1.75rem;
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.85rem;
    }

    @mixin tablet-up {
        .csd-arch-layer {
            grid-template-columns: 160px 1fr;
            grid-template-rows: auto auto;
            column-gap: 2rem;
        }

        .csd-arch-layer__header {
            grid-row: 1;
            grid-column: 1;
            padding-top: 0.15rem;
        }

        .csd-arch-layer__chips {
            grid-row: 1;
            grid-column: 2;
        }

        .csd-arch-layer__desc {
            grid-row: 2;
            grid-column: 2;
        }
    }

    .csd-arch-layer__name {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-accent);
    }

    .csd-arch-layer__chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .csd-arch-chip {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.25rem 0.7rem;
        border-radius: 0.35rem;
        background: color-mix(in srgb, var(--color-accent) 6%, transparent);
        border: 1px solid color-mix(in srgb, var(--color-accent) 18%, transparent);
        color: var(--color-text-primary);
    }

    .csd-arch-layer__desc {
        font-size: 0.84rem;
        color: var(--color-text-secondary);
        line-height: 1.65;
        margin: 0;
    }
</style>
